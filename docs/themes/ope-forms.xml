<?xml version="1.0" encoding="UTF-8"?>
<theme name="One Piece: Eternal" version="1839">
  <templates>
    <template name="newthread" version="1839"><![CDATA[
<html><head>{$headerinclude}</head><body>
<div id="ope-breadcrumb"><div class="ope-breadcrumb-in"><a href="{$mybb->settings['bburl']}/index.php">Inicio</a><span class="sep">›</span>{$breadcrumb}</div></div>
{$header}
<div class="ope-wrap ope-wrap-form">
  <div class="ope-shead"><h1>Nueva historia</h1><span class="ope-shead-code">// nuevo tema</span><span class="ope-shead-rule"></span></div>
  {$preview}
  <div class="ope-plate">
    <div class="ope-plate-h"><span class="ope-plate-h-t">{$forum['name']}</span><span class="ope-plate-h-c">// comienza tu historia</span></div>
    <div class="ope-plate-b">
      <form action="newthread.php?fid={$fid}&amp;processed=1" method="post" enctype="multipart/form-data">
        <input type="hidden" name="my_post_key" value="{$mybb->post_code}" />
        <input type="hidden" name="action" value="do_newthread" />
        <div class="ope-form-field">
          <label>Prefijo</label>
          {$prefixselect}
        </div>
        <div class="ope-form-field">
          <label>Asunto</label>
          <input type="text" name="subject" class="ope-form-input-full" value="{$subject}" maxlength="85" />
        </div>
        <div class="ope-meta-fields">
          <div class="ope-meta-field">
            <label>Época Temporal</label>
            <select name="temporal_tipo" id="temporal_tipo" class="ope-meta-sel" onchange="document.getElementById('ope-fecha-pasado-wrap').style.display = (this.value==='pasado'?'flex':'none')">
              <option value="presente" selected>Presente &middot; Fecha Actual del Foro</option>
              <option value="pasado">Pasado &middot; Fecha Histórica Personalizada</option>
            </select>
          </div>
          <div id="ope-fecha-pasado-wrap" class="ope-fecha-wrap" style="display:none">
            <div class="ope-meta-field">
              <label>Día (1&ndash;65)</label>
              <input type="number" name="temporal_dia" class="ope-meta-sel" min="1" max="65" step="1" value="1" placeholder="1-65" />
            </div>
            <div class="ope-meta-field">
              <label>Estación</label>
              <select name="temporal_estacion" class="ope-meta-sel">
                <option value="Primavera">Primavera</option>
                <option value="Verano">Verano</option>
                <option value="Otoño">Otoño</option>
                <option value="Invierno">Invierno</option>
              </select>
            </div>
            <div class="ope-meta-field">
              <label>Año in-rol</label>
              <input type="number" name="temporal_ano" class="ope-meta-sel" min="1000" max="3000" step="1" value="1518" placeholder="ej: 1518" />
            </div>
          </div>
          <div class="ope-meta-field">
            <label>Tipo de Tema</label>
            <select name="tema_tipo" class="ope-meta-sel">
              <option value="travesia">Travesía</option>
              <option value="aventura">Aventura</option>
              <option value="fic">Fic</option>
              <option value="combate">Combate</option>
              <option value="entrenamiento">Entrenamiento</option>
              <option value="social" selected>Social</option>
              <option value="trama">Trama</option>
            </select>
          </div>
        </div>
        <script>
        (function(){
          var e=document.getElementById('ope_era'),f=document.getElementById('ope-fecha-wrap');
          if(!e||!f)return;
          var pasadoFields=f.querySelectorAll('input,select');
          function u(){
            var p=(e.value==='pasado');
            f.classList.toggle('is-on',p);
            pasadoFields.forEach(function(el){el.disabled=!p;});
          }
          e.addEventListener('change',u);u();
        })();
        </script>
        <div class="ope-form-field">
          <label>Mensaje</label>
          <div class="ope-plate ope-tools">
            <div class="ope-plate-h"><span class="ope-plate-h-t">Herramientas</span><span class="ope-plate-h-c">// editor completo</span></div>
            <div class="ope-plate-b">
              {$codebuttons}
              <textarea name="message" id="message" class="ope-form-textarea-full" rows="20">{$message}</textarea>
            </div>
          </div>
          {$ope_tpl_inserter}
        </div>
        {$posticons}
        {$postoptions}
        <div class="ope-form-actions">
          <input type="submit" name="submit" class="ope-btn ope-btn-hot" value="Publicar historia" />
          <input type="submit" name="previewpost" class="ope-btn ope-btn-ghost" value="Previsualizar" />
          <input type="submit" name="savedraft" class="ope-btn ope-btn-ghost" value="Guardar borrador" />
        </div>
      </form>
    </div>
  </div>
</div>
{$footer}
</body></html>
]]></template>

