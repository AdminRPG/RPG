<?xml version="1.0" encoding="UTF-8"?>
<theme name="I-Forge RPG" version="1839">
  <templates>
    <template name="newthread" version="1839"><![CDATA[
<html><head>{$headerinclude}</head><body>
<div id="ope-breadcrumb"><div class="ope-breadcrumb-in"><a href="{$mybb->settings['bburl']}/index.php">Inicio</a><span class="sep">›</span>{$breadcrumb}</div></div>
{$header}
<div class="ope-wrap" style="padding-top:16px">
  <div class="ope-shead"><h1>Nueva historia</h1><span class="ope-shead-code">// nuevo tema</span><span class="ope-shead-rule"></span></div>
  {$preview}
  <div class="ope-plate">
    <div class="ope-plate-h"><span class="ope-plate-h-t">{$forum['name']}</span><span class="ope-plate-h-c">// comienza tu historia</span></div>
    <div class="ope-plate-b">
      <form action="newthread.php?fid={$fid}&amp;processed=1" method="post" enctype="multipart/form-data">
        <input type="hidden" name="my_post_key" value="{$mybb->post_code}" />
        <input type="hidden" name="action" value="do_newthread" />
        <div style="margin-bottom:12px">
          <label>Prefijo</label><br>
          {$prefixselect}
        </div>
        <div style="margin-bottom:12px">
          <label>Asunto</label><br>
          <input type="text" name="subject" value="{$subject}" style="width:100%" maxlength="85" />
        </div>
        <div class="ope-meta-fields">
          <div class="ope-meta-field">
            <label>&Eacute;poca</label>
            <select name="ope_era" id="ope_era" class="ope-meta-sel">
              <option value="presente">Presente &middot; fecha actual (inalterable)</option>
              <option value="pasado">Pasado</option>
            </select>
          </div>
          <div id="ope-fecha-wrap" style="display:none">
            <div class="ope-meta-field">
              <label>A&ntilde;o in-rol</label>
              <input type="number" name="ope_fecha_rol" id="ope_fecha_rol" class="ope-meta-sel" min="0" max="9999" step="1" placeholder="p. ej. 1518" />
            </div>
            <div class="ope-meta-field">
              <label>D&iacute;a</label>
              <input type="number" name="ope_fecha_dia" class="ope-meta-sel" min="1" max="65" step="1" placeholder="1&ndash;65" />
            </div>
            <div class="ope-meta-field">
              <label>Estaci&oacute;n</label>
              <select name="ope_estacion" class="ope-meta-sel">
                <option value="">Autom&aacute;tica (por d&iacute;a)</option>
                <option value="Primavera">Primavera</option>
                <option value="Verano">Verano</option>
                <option value="Oto&ntilde;o">Oto&ntilde;o</option>
                <option value="Invierno">Invierno</option>
              </select>
            </div>
          </div>
          <div class="ope-meta-field">
            <label>Etiqueta</label>
            <select name="ope_tag" class="ope-meta-sel">
              <option value="">Sin etiqueta</option>
              <option value="Mision">Misi&oacute;n</option>
              <option value="Trama">Trama</option>
              <option value="Viaje">Viaje</option>
              <option value="Fic">Fic</option>
            </select>
          </div>
        </div>
        <script>
        (function(){
          var e=document.getElementById('ope_era'),f=document.getElementById('ope-fecha-wrap');
          if(!e||!f)return;
          var pasadoFields=f.querySelectorAll('input,select');
          function u(){
            var p=(e.value==='pasado');
            f.style.display=p?'flex':'none';
            f.style.flexWrap='wrap';
            f.style.gap='14px';
            pasadoFields.forEach(function(el){el.disabled=!p;});
          }
          e.addEventListener('change',u);u();
        })();
        </script>
        <div style="margin-bottom:12px">
          <label>Mensaje</label><br>
          {$codebuttons}
          {$ope_tpl_inserter}
          <textarea name="message" id="message" rows="20" style="width:100%">{$message}</textarea>
        </div>
        {$posticons}
        {$postoptions}
        <div style="margin-top:14px;display:flex;gap:10px">
          <input type="submit" class="ope-btn ope-btn-hot" value="Publicar historia" />
          <input type="submit" name="previewpost" class="ope-btn ope-btn-ghost" value="Previsualizar" />
          <input type="submit" name="savedraft" class="ope-btn ope-btn-ghost" value="Guardar borrador" />
        </div>
      </form>
    </div>
  </div>
</div>
{$footer}
</body></html>
]]></template>

    <template name="newreply" version="1839"><![CDATA[
<html><head>{$headerinclude}</head><body>
<div id="ope-breadcrumb"><div class="ope-breadcrumb-in"><a href="{$mybb->settings['bburl']}/index.php">Inicio</a><span class="sep">›</span>{$breadcrumb}</div></div>
{$header}
<div class="ope-wrap" style="padding-top:16px">
  <div class="ope-shead"><h1>Responder</h1><span class="ope-shead-code">// nueva respuesta</span><span class="ope-shead-rule"></span></div>
  {$preview}
  <div class="ope-plate">
    <div class="ope-plate-h"><span class="ope-plate-h-t">{$thread['subject']}</span><span class="ope-plate-h-c">// continúa la historia</span></div>
    <div class="ope-plate-b">
      <form action="newreply.php?tid={$tid}&amp;processed=1" method="post" enctype="multipart/form-data">
        <input type="hidden" name="my_post_key" value="{$mybb->post_code}" />
        <div style="margin-bottom:12px">
          <label>Mensaje</label><br>
          {$codebuttons}
          {$ope_tpl_inserter}
          <textarea name="message" id="message" rows="20" style="width:100%">{$message}</textarea>
          {$multiquote_external}
        </div>
        {$posticons}
        {$postoptions}
        {$modoptions}
        <div style="margin-top:14px;display:flex;gap:10px">
          <input type="submit" class="ope-btn ope-btn-hot" value="Publicar respuesta" />
          <input type="submit" name="previewpost" class="ope-btn ope-btn-ghost" value="Previsualizar" />
        </div>
      </form>
    </div>
  </div>
  {$threadreview}
</div>
{$footer}
</body></html>
]]></template>

    <template name="editpost" version="1839"><![CDATA[
<html><head>{$headerinclude}</head><body>
<div id="ope-breadcrumb"><div class="ope-breadcrumb-in"><a href="{$mybb->settings['bburl']}/index.php">Inicio</a><span class="sep">›</span>{$breadcrumb}</div></div>
