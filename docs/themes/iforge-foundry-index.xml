    <template name="index" version="1839"><![CDATA[<html>
<head>
{$headerinclude}
</head>
<body>
<!-- La navbar (única para todo el sitio) la inyecta el hook pre_output_page
     del plugin iforge_rol justo tras <body>. -->

<!-- ===== TICKER (ember background, running text) ===== -->
<div id="iforge-ticker" aria-label="Estado de la fragua">
  <div class="iforge-ticker-run">
    <span>Fragua encendida · {$mybb->settings['bbname']}</span>
    <span>{$lang->welcome_current_time}</span>
    <span>{$stats['numusers']} forjadores</span>
    <span>{$stats['numthreads']} coladas</span>
    <span>{$stats['numposts']} mensajes</span>
    <span>Fragua encendida · {$mybb->settings['bbname']}</span>
    <span>{$lang->welcome_current_time}</span>
    <span>{$stats['numusers']} forjadores</span>
    <span>{$stats['numthreads']} coladas</span>
    <span>{$stats['numposts']} mensajes</span>
  </div>
</div>

{$header}

<!-- ===== HERO ===== -->
<header class="iforge-hero">
  <div class="iforge-hero-in">
    <div>
      <div class="iforge-eyebrow">Fragua N.&ordm; 001 &middot; Foro de rol play-by-post</div>
      <h1 class="iforge-hero-title">Aqu&iacute; se<br><b>forjan</b> los<br>personajes</h1>
      <p class="iforge-hero-sub">{$mybb->settings['bbname']} es el yunque donde tu personaje toma forma: <b>ficha, mec&aacute;nicas, inventario y cr&oacute;nica</b> en una sola herramienta. Golpea el metal mientras est&aacute; caliente.</p>
      <div class="iforge-hero-btns">
        <a href="{$mybb->settings['bburl']}/crear-personaje.php" class="iforge-btn iforge-btn-hot">Forjar personaje</a>
        <a href="{$mybb->settings['bburl']}/tramites.php" class="iforge-btn iforge-btn-ghost">Tr&aacute;mites del taller</a>
      </div>
    </div>
    <div class="iforge-anvil" aria-hidden="true">
      <span class="glow"></span>
      <svg viewBox="0 0 200 190">
        <g fill="#31353d" stroke="#000" stroke-width="3" stroke-linejoin="round">
          <path d="M14 78 L44 60 H172 V86 H120 V96 L150 104 V118 H150 L120 110 V150 H150 V168 H50 V150 H80 V96 H44 V78 Z"/>
        </g>
        <path d="M44 60 H172 V72 H44 Z" fill="#3f444d"/>
        <circle cx="150" cy="52" r="3" fill="#f4b02f"/>
        <circle cx="164" cy="40" r="2" fill="#ef8b1e"/>
        <circle cx="138" cy="38" r="2.4" fill="#fdf4cf"/>
        <circle cx="176" cy="60" r="1.8" fill="#e0641f"/>
      </svg>
    </div>
  </div>
</header>

<!-- ===== CENSO (real stats) ===== -->
<section class="iforge-census">
  <div class="iforge-census-in">
    <div class="iforge-census-c"><div class="iforge-census-v">{$stats['numusers']}</div><div class="iforge-census-l">Forjadores</div></div>
    <div class="iforge-census-c"><div class="iforge-census-v">{$stats['numthreads']}</div><div class="iforge-census-l">Coladas</div></div>
    <div class="iforge-census-c"><div class="iforge-census-v">{$stats['numposts']}</div><div class="iforge-census-l">Mensajes en el archivo</div></div>
    <div class="iforge-census-c"><div class="iforge-census-v" style="font-size:1.15rem;font-family:var(--body);font-weight:700">{$stats['lastusername']}</div><div class="iforge-census-l">&Uacute;ltimo forjador</div></div>
  </div>
</section>

<!-- ===== TABL&Oacute;N (bento: lore destacado, feed, curiosidad, staff) ===== -->
<section class="iforge-tablon">

  <!-- Reloj on-rol: 4 estaciones &times; 65 d&iacute;as -->
  <div class="iforge-onrol" style="--season:{$iforge_rol_season_color}">
    <span class="iforge-onrol-dot" aria-hidden="true"></span>
    <span class="iforge-onrol-label">Calendario on-rol</span>
    <span class="iforge-onrol-season">{$iforge_rol_season}</span>
    <span class="iforge-onrol-day">D&iacute;a {$iforge_rol_day} <i>/ 65</i></span>
    <span class="iforge-onrol-year">A&ntilde;o {$iforge_rol_year_label}</span>
    <span class="iforge-onrol-bar"><i style="width:{$iforge_rol_progress}%"></i></span>
  </div>

  <div class="iforge-tablon-grid">

    <!-- Panel destacado: lore -->
    <article class="iforge-panel iforge-panel-lore" style="grid-area:lore">
      <span class="iforge-panel-glow" aria-hidden="true"></span>
      <svg class="iforge-panel-mark" viewBox="0 0 200 190" aria-hidden="true">
        <g fill="currentColor"><path d="M14 78 L44 60 H172 V86 H120 V96 L150 104 V118 H150 L120 110 V150 H150 V168 H50 V150 H80 V96 H44 V78 Z"/></g>
      </svg>
      <div class="iforge-panel-kicker">// el mundo ahora</div>
      <h3 class="iforge-panel-title">{$iforge_lore_title}</h3>
      <p class="iforge-panel-text">{$iforge_lore_text}</p>
      <a href="{$mybb->settings['bburl']}/guias.php" class="iforge-btn iforge-btn-hot iforge-btn-sm">Leer m&aacute;s &rarr;</a>
    </article>

    <!-- Feed: &uacute;ltimas coladas -->
    <article class="iforge-panel iforge-panel-feed" style="grid-area:feed">
      <div class="iforge-panel-h">
        <span class="iforge-live" aria-hidden="true"></span>
        <span class="iforge-panel-h-t">&Uacute;ltimas coladas</span>
        <a class="iforge-panel-h-more" href="{$mybb->settings['bburl']}/search.php?action=getnew">ver todas &rarr;</a>
      </div>
      <div class="iforge-feed">{$iforge_latest_posts}</div>
    </article>

    <!-- Curiosidad rotativa -->
    <article class="iforge-panel iforge-panel-curio" style="grid-area:curio">
      <span class="iforge-curio-q" aria-hidden="true">&ldquo;</span>
      <div class="iforge-panel-kicker">// curiosidad</div>
      <p id="iforge-curiosidad-text" class="iforge-curio-text">{$iforge_curiosidad}</p>
      <span class="iforge-curio-bar"><i id="iforge-curio-bar"></i></span>
    </article>

    <!-- Staff -->
    <article class="iforge-panel iforge-panel-staff" style="grid-area:staff">
      <div class="iforge-panel-kicker">// el taller</div>
      <div class="iforge-staff-list">{$iforge_staff_list}</div>
    </article>

    <!-- Discord (fuera de la zona de staff, pero dentro del tablón) -->
    <article class="iforge-panel iforge-panel-discord" style="grid-area:discord">
      <a href="{$iforge_discord_url}" target="_blank" rel="noopener" class="iforge-discord-btn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.07.07 0 0 0-.075.035c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.076-.035A19.736 19.736 0 0 0 3.68 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.073.073 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.128 12.3 12.3 0 0 1-1.873.891.076.076 0 0 0-.04.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.955 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        <span>Únete al Discord</span>
      </a>
    </article>

  </div>
</section>

<!-- ===== TALLERES (categories as section headers + forum rows) ===== -->
{$forums}

<!-- ===== PRESENCIA (activos ahora + &uacute;ltimas 24 h) ===== -->
<section class="iforge-presence">
  <div class="iforge-mod">
    <div class="iforge-mod-h"><span class="iforge-mod-h-t">En la fragua ahora</span><span class="iforge-mod-h-c">{$iforge_online_now_count}</span></div>
    <div class="iforge-mod-b"><div class="iforge-online">{$iforge_online_now}</div></div>
  </div>
  <div class="iforge-mod">
    <div class="iforge-mod-h"><span class="iforge-mod-h-t">Activos en las &uacute;ltimas 24 h</span><span class="iforge-mod-h-c">{$iforge_online_24h_count}</span></div>
    <div class="iforge-mod-b"><div class="iforge-online">{$iforge_online_24h}</div></div>
  </div>
</section>

<script type="text/javascript">
(function(){
  var data = {$curiosidades_json};
  var el = document.getElementById('iforge-curiosidad-text');
  var bar = document.getElementById('iforge-curio-bar');
  if(!el || !data || data.length < 2) return;
  var i = 0, period = 9000;
  function restartBar(){
    if(!bar) return;
    bar.style.transition = 'none';
    bar.style.width = '0%';
    void bar.offsetWidth;
    bar.style.transition = 'width ' + period + 'ms linear';
    bar.style.width = '100%';
  }
  restartBar();
  setInterval(function(){
    i = (i + 1) % data.length;
    el.style.opacity = 0;
    setTimeout(function(){ el.textContent = data[i]; el.style.opacity = 1; }, 220);
    restartBar();
  }, period);
})();
</script>

{$footer}
</body>
</html>]]></template>

