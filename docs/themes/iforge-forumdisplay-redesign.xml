=== CSS ===
/* ===== I-Forge RPG - ForumDisplay Brutalist Manga Theme ===== */
/* NO <table>/<tr>/<td>. NO tborder/tcat/thead/trow1/trow2/tfoot/smalltext classes. */
/* Permanent Marker for headings, serif for body, sans for UI. 3px solid borders, hard shadows, gold accents. */

@import url('https://fonts.googleapis.com/css2?family=Permanent+Marker&display=swap');

:root {
  --bg: #f4f0e6;
  --bg-dark: #ebe6d6;
  --panel: #2d5a27;
  --panel-hover: #3d7a35;
  --gold: #c9a84c;
  --gold-hover: #e2c96b;
  --ink: #1a1a1a;
  --ink-secondary: #5a5a4a;
  --border: #1e3d1a;
  --shadow: 3px 3px 0 #1e3d1a;
  --shadow-hover: 4px 4px 0 #1e3d1a;
  --radius: 3px;
  --font-brush: 'Permanent Marker', 'Comic Sans MS', 'Chalkboard SE', cursive;
  --font-serif: Georgia, 'Palatino Linotype', 'Times New Roman', serif;
  --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
}

/* ===== NAVBAR ===== */
#iforge-navbar {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  z-index: 10000 !important;
  background: var(--panel);
  border-bottom: 3px solid var(--border);
  box-shadow: var(--shadow);
}
.iforge-nav {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56px;
  padding: 0 16px;
  position: relative;
}
.iforge-nav-left { display: flex; align-items: center; gap: 24px; }
.iforge-nav-logo {
  position: absolute;
  left: 16px;
  font-family: var(--font-brush);
  font-size: 1.4rem;
  color: var(--gold);
  letter-spacing: 2px;
  text-transform: uppercase;
  text-shadow: 2px 2px 0 var(--border);
}
.iforge-nav-logo:hover { color: var(--gold-hover); }
.iforge-nav-link {
  color: #fff;
  font-family: var(--font-sans);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 4px 0;
  position: relative;
}
.iforge-nav-link:hover { color: var(--gold-hover); }
.iforge-nav-link::after {
  content: '';
  position: absolute;
  bottom: -4px; left: 0; right: 0;
  height: 3px;
  background: var(--gold);
  transform: scaleX(0);
  transition: transform 0.2s;
}
.iforge-nav-link:hover::after { transform: scaleX(1); }
.iforge-nav-right { position: absolute; right: 16px; }
.iforge-user-btn {
  background: var(--panel-hover);
  border: 3px solid var(--border);
  border-radius: 50%;
  width: 36px; height: 36px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold);
  font-weight: 700;
  box-shadow: 2px 2px 0 var(--border);
}
.iforge-user-btn:hover { background: var(--gold); color: var(--panel); }
.iforge-dropdown {
  display: none;
  position: absolute;
  right: 0; top: 46px;
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  min-width: 180px;
  overflow: hidden;
}
.iforge-dropdown.open { display: block; }
.iforge-dropdown-item {
  display: block;
  padding: 8px 14px;
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 0.8rem;
  font-weight: 600;
  border-bottom: 2px solid var(--border);
  transition: background 0.15s;
}
.iforge-dropdown-item:last-child { border-bottom: none; }
.iforge-dropdown-item:hover { background: var(--gold); color: var(--panel); }
.iforge-dropdown-divider { border: none; border-top: 2px solid var(--border); margin: 0; }

/* ===== BANNER ===== */
#iforge-banner {
  position: relative;
  width: 100%;
  height: 300px;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  border-bottom: 3px solid var(--border);
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
}
#iforge-banner::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(244,240,230,0.25) 0%, rgba(30,61,26,0.6) 100%);
}
.iforge-banner-seal {
  position: absolute;
  z-index: 1;
  color: rgba(30,61,26,0.14);
  font-size: 200px;
  pointer-events: none;
  font-family: var(--font-brush);
  user-select: none;
  letter-spacing: 4px;
}
.iforge-banner-content { position: relative; z-index: 2; text-align: center; }
.iforge-banner-title {
  font-family: var(--font-brush);
  font-size: 3rem;
  color: var(--gold);
  letter-spacing: 5px;
  text-transform: uppercase;
  text-shadow: 3px 3px 0 var(--border), -1px -1px 0 rgba(255,255,255,0.3);
  margin-bottom: 6px;
}
.iforge-banner-subtitle {
  font-family: var(--font-serif);
  font-size: 1rem;
  color: #fff;
  letter-spacing: 3px;
  font-weight: 700;
  text-shadow: 2px 2px 0 var(--border);
}

/* ===== CALENDAR BAR ===== */
#iforge-calendar-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 16px;
  background: var(--panel);
  border-bottom: 3px solid var(--border);
  box-shadow: var(--shadow);
  font-family: var(--font-sans);
  font-size: 0.78rem;
  color: #fff;
  letter-spacing: 1px;
  text-transform: uppercase;
  font-weight: 700;
  cursor: pointer;
}
#iforge-calendar-bar:hover { background: var(--panel-hover); }
#iforge-calendar-bar .icon { width: 14px; height: 14px; filter: brightness(0) invert(1); }
#iforge-calendar-bar strong { color: var(--gold); }

/* ===== FORUM CONTAINER ===== */
.iforge-forum-container {
  max-width: 1200px;
  margin: 16px auto 0;
  padding: 0 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  font-family: var(--font-serif);
}

/* ===== THREADLIST ===== */
.iforge-threadlist {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.iforge-threadlist-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  background: var(--panel);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
}
.iforge-threadlist-sort {
  font-family: var(--font-sans);
  font-size: 0.78rem;
  color: var(--gold);
  text-transform: uppercase;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6px;
}
.iforge-threadlist-sort a { color: #fff; font-weight: 700; }

.iforge-newthread-btn {
  display: inline-block;
  padding: 6px 14px;
  background: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.85rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 1px;
  text-decoration: none;
  transition: background 0.15s, transform 0.15s;
}
.iforge-newthread-btn:hover { background: var(--gold-hover); transform: translateY(-1px); }

.iforge-threadlist-pagination-top,
.iforge-threadlist-pagination-bottom {
  display: flex;
  justify-content: center;
  padding: 4px 0;
}

.iforge-threads {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

/* ===== THREAD ROW ===== */
.iforge-thread-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  transition: transform 0.15s, border-color 0.15s;
}
.iforge-thread-row:hover { transform: translateY(-1px); border-color: var(--gold); }

.iforge-thread-main {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  min-width: 0;
}
.iforge-thread-icon {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
}
.iforge-thread-icon img { width: 20px; height: 20px; }

.iforge-thread-info { min-width: 0; flex: 1; }

.iforge-thread-title-row {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
  min-width: 0;
}

.iforge-thread-title {
  display: inline;
  font-family: var(--font-sans);
  font-size: 0.9rem;
  color: var(--panel);
  font-weight: 700;
  text-decoration: none;
}
.iforge-thread-title:hover { color: var(--gold); }

.iforge-thread-meta {
  display: block;
  font-family: var(--font-sans);
  font-size: 0.7rem;
  color: var(--ink-secondary);
  margin-top: 2px;
}

.iforge-thread-stats {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-shrink: 0;
  font-family: var(--font-sans);
  font-size: 0.72rem;
  color: var(--ink-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.iforge-thread-replies strong { color: var(--panel); font-size: 0.85rem; }

.iforge-thread-lastpost {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: 0.7rem;
}
.iforge-thread-lastpost a { color: var(--gold); font-weight: 600; }
.iforge-thread-lastpost a:hover { color: var(--gold-hover); }
.iforge-thread-last-label { color: var(--ink); font-weight: 700; font-size: 0.65rem; }

.iforge-threadlist-toolbar-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 8px 0;
  flex-wrap: wrap;
}

/* ===== SUBFORUMS ===== */
.iforge-subforums {
  padding: 4px 14px 8px;
}
.iforge-subforums-label {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  color: var(--ink-secondary);
  text-transform: uppercase;
  font-weight: 700;
}
.iforge-subforums-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 4px;
}
.iforge-sub-link {
  display: inline-block;
  padding: 1px 8px;
  background: var(--panel);
  color: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.62rem;
  font-weight: 700;
  text-transform: uppercase;
  text-decoration: none;
  transition: background 0.15s, transform 0.15s;
}
.iforge-sub-link:hover { background: var(--panel-hover); transform: translateY(-1px); }
.iforge-sub-icon {
  font-size: 0.75rem;
  color: var(--gold);
  margin-right: 1px;
  vertical-align: middle;
}
.iforge-sub-icon-on { color: var(--gold); }
.iforge-sub-icon-off { color: var(--ink-secondary); }
.iforge-sub-icon-offlock { color: var(--ink-secondary); }

/* ===== ANNOUNCEMENTS ===== */
.iforge-announcements {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 6px;
}
.iforge-announcements-header {
  font-family: var(--font-brush);
  font-size: 0.85rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 6px 14px;
  background: var(--panel);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
}

.iforge-announcement-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: rgba(201,168,76,0.1);
  border: 3px solid var(--gold);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
}
.iforge-announcement-icon { flex-shrink: 0; }
.iforge-announcement-info { min-width: 0; }
.iforge-announcement-row a {
  color: var(--gold);
  font-weight: 700;
  font-family: var(--font-sans);
  font-size: 0.85rem;
}
.iforge-announcement-row .iforge-thread-meta { color: rgba(255,255,255,0.7); display: block; }

/* ===== SORT BAR ===== */
.iforge-sort-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  padding: 0;
}
.iforge-sort-bar form {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
}
.iforge-sort-bar select {
  padding: 4px 8px;
  background: var(--panel-hover);
  color: #fff;
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
}
.iforge-go-btn {
  padding: 4px 10px;
  background: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.7rem;
  color: var(--panel);
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.15s, transform 0.15s;
}
.iforge-go-btn:hover { background: var(--gold-hover); transform: translateY(-1px); }

/* ===== ORDER ARROW ===== */
.iforge-order-arrow {
  font-size: 0.78rem;
  margin-left: 2px;
  font-weight: 700;
}
.iforge-order-arrow a { color: var(--gold); font-weight: 700; text-decoration: none; }
.iforge-order-arrow a:hover { color: var(--gold-hover); }

/* ===== SEARCH FORM ===== */
.iforge-search-form {
  display: flex;
  align-items: center;
  gap: 4px;
}
.iforge-search-label {
  font-family: var(--font-sans);
  font-size: 0.7rem;
  color: var(--ink);
  font-weight: 700;
  text-transform: uppercase;
}
.iforge-search-input {
  padding: 4px 8px;
  background: var(--bg-dark);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.7rem;
  color: var(--ink);
}
.iforge-search-submit {
  padding: 4px 10px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.68rem;
  color: var(--gold);
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.15s, transform 0.15s;
}
.iforge-search-submit:hover { background: var(--panel-hover); transform: translateY(-1px); }

/* ===== THREAD ICON CHARS ===== */
.iforge-thread-icon-char {
  display: inline-block;
  width: 18px;
  height: 18px;
  font-size: 1rem;
  line-height: 1;
  text-align: center;
  flex-shrink: 0;
}
.iforge-thread-icon-newfolder .iforge-thread-icon-char,
.iforge-thread-icon-newfolderstate { color: var(--panel); }
.iforge-thread-icon-newhotfolder .iforge-thread-icon-char,
.iforge-thread-icon-newhotfolderstate { color: var(--gold); }
.iforge-thread-icon-hotfolder .iforge-thread-icon-char,
.iforge-thread-icon-hotfolderstate { color: var(--gold-hover); }
.iforge-thread-icon-folder .iforge-thread-icon-char,
.iforge-thread-icon-folderstate { color: var(--ink-secondary); }
.iforge-thread-icon-closefolder .iforge-thread-icon-char,
.iforge-thread-icon-closefolderstate { color: var(--ink-secondary); }
.iforge-thread-icon-dot_folder .iforge-thread-icon-char,
.iforge-thread-icon-dot_folderstate { color: var(--gold); }

.iforge-thread-icon-unread { color: var(--panel); }
.iforge-thread-icon-read { color: var(--ink-secondary); }
.iforge-thread-icon-hot { color: var(--gold); }
.iforge-thread-icon-locked { color: var(--ink-secondary); }
.iforge-thread-icon-dot { color: var(--gold); }

/* ===== ATTACHMENT BADGE ===== */
.iforge-attach-badge {
  display: inline-block;
  padding: 1px 6px;
  background: var(--panel);
  color: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 1px 1px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.62rem;
  font-weight: 700;
  vertical-align: middle;
  margin-left: 4px;
}

/* ===== THREAD MULTIPAGE IN ROW ===== */
.iforge-thread-pages {
  display: inline-flex;
  gap: 2px;
  margin-left: 6px;
  vertical-align: middle;
}
.iforge-thread-pages a, .iforge-thread-pages span {
  display: inline-block;
  padding: 1px 5px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 2px;
  font-family: var(--font-sans);
  font-size: 0.62rem;
  font-weight: 700;
  color: var(--ink);
  text-decoration: none;
}
.iforge-thread-pages a:hover { background: var(--gold); color: var(--panel); }
.iforge-thread-pages-ellipsis {
  background: transparent !important;
  border: none !important;
  color: var(--ink-secondary);
}

/* ===== MODERATION BAR ===== */
.iforge-mod-bar {
  background: var(--panel);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  font-family: var(--font-sans);
  font-size: 0.7rem;
}
.iforge-mod-bar form {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.iforge-mod-bar-label {
  font-family: var(--font-brush);
  font-size: 0.72rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.iforge-mod-bar select {
  padding: 3px 6px;
  background: var(--panel-hover);
  color: #fff;
  border: 2px solid var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
}
.iforge-mod-go, .iforge-mod-clear {
  padding: 3px 10px;
  background: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.65rem;
  color: var(--panel);
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.15s, transform 0.15s;
}
.iforge-mod-go:hover, .iforge-mod-clear:hover {
  background: var(--gold-hover);
  transform: translateY(-1px);
}
.iforge-mod-selectall {
  font-family: var(--font-sans);
  font-size: 0.68rem;
  color: #fff;
  padding: 4px 8px;
}
.iforge-mod-selectall a { color: var(--gold); font-weight: 700; }
.iforge-mod-selectall a:hover { color: var(--gold-hover); }
.iforge-mod-selectall-msg {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  color: #fff;
  padding: 2px 0;
}
.iforge-mod-selectall-msg a { color: var(--gold); font-weight: 700; }
.iforge-mod-selectall-msg a:hover { color: var(--gold-hover); }

/* ===== PREFIX PILLS / FILTERS ===== */
.iforge-prefix-pills {
  display: inline-flex;
  gap: 4px;
  flex-wrap: wrap;
}
.iforge-prefix-pills select {
  padding: 3px 6px;
  background: var(--panel-hover);
  color: #fff;
  border: 2px solid var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
}

/* ===== CLEAR / SUBSCRIPTION LINKS ===== */
.iforge-clear-link {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  font-weight: 600;
  color: var(--panel);
  text-decoration: none;
  text-transform: uppercase;
  padding: 2px 6px;
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  background: var(--bg-dark);
  display: inline-block;
  transition: background 0.15s, transform 0.15s;
}
.iforge-clear-link:hover { background: var(--gold); color: var(--panel); transform: translateY(-1px); }

/* ===== MODERATED BY ===== */
.iforge-mod-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  align-items: center;
  font-family: var(--font-sans);
  font-size: 0.7rem;
  color: var(--ink-secondary);
  padding: 4px 0;
}
.iforge-mod-badges-label {
  font-weight: 700;
  text-transform: uppercase;
  font-size: 0.68rem;
  color: var(--ink);
}
.iforge-mod-badges a {
  display: inline-block;
  padding: 2px 8px;
  background: var(--panel);
  color: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  text-decoration: none;
  transition: transform 0.15s, border-color 0.15s;
}
.iforge-mod-badges a:hover { transform: translateY(-1px); border-color: var(--gold); color: var(--gold-hover); }

/* ===== USERS BROWSING ===== */
.iforge-users-browsing {
  font-family: var(--font-sans);
  font-size: 0.7rem;
  color: var(--ink-secondary);
  padding: 6px 0;
  line-height: 1.6;
}
.iforge-users-browsing a { color: var(--panel); font-weight: 600; }
.iforge-users-browsing a:hover { color: var(--gold); }

/* ===== EMPTY / NO THREADS ===== */
.iforge-empty-card {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  padding: 24px 16px;
  text-align: center;
  font-family: var(--font-sans);
}
.iforge-empty-card-title {
  font-family: var(--font-brush);
  font-size: 1.1rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 8px;
}
.iforge-empty-card-text {
  font-size: 0.85rem;
  color: var(--ink-secondary);
  margin-bottom: 12px;
}
.iforge-empty-card-btn {
  display: inline-block;
  padding: 6px 14px;
  background: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.8rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  text-decoration: none;
  transition: background 0.15s, transform 0.15s;
}
.iforge-empty-card-btn:hover { background: var(--gold-hover); transform: translateY(-1px); }

/* ===== DELETED THREAD ===== */
.iforge-thread-deleted {
  opacity: 0.7;
}
.iforge-thread-deleted-text {
  font-family: var(--font-sans);
  font-size: 0.8rem;
  color: var(--ink-secondary);
  font-style: italic;
}

/* ===== THREAD RATING ===== */
.iforge-thread-rating {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.iforge-thread-rating .star_rating {
  list-style: none;
  height: 12px;
  position: relative;
  width: 60px;
}
.iforge-thread-rating .star_rating .current_rating {
  height: 12px;
  position: absolute;
  left: 0;
  top: 0;
}

/* ===== THREAD MODBIT ===== */
.iforge-thread-modbit {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-left: 8px;
}
.iforge-thread-modbit input.checkbox {
  width: 14px;
  height: 14px;
  accent-color: var(--gold);
  cursor: pointer;
}

/* ===== UNAPPROVED BADGE ===== */
.iforge-unapproved-badge {
  display: inline-block;
  padding: 1px 6px;
  background: #b42828;
  color: #fff;
  border: 1px solid #7a1a1a;
  border-radius: 2px;
  font-family: var(--font-sans);
  font-size: 0.6rem;
  font-weight: 700;
  margin-left: 3px;
  vertical-align: middle;
}

/* ===== RULES CARD ===== */
.iforge-rules-card {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
}
.iforge-rules-card-header {
  padding: 10px 14px;
  background: var(--panel);
  border-bottom: 3px solid var(--border);
  font-family: var(--font-brush);
  font-size: 0.95rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
}
.iforge-rules-card-body {
  padding: 12px 14px;
  font-size: 0.85rem;
  color: var(--ink);
  line-height: 1.6;
}
.iforge-rules-link {
  display: inline-block;
  padding: 3px 10px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.7rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  text-decoration: none;
  transition: background 0.15s, transform 0.15s;
}
.iforge-rules-link:hover { background: var(--panel-hover); transform: translateY(-1px); }

/* ===== PASSWORD CARD ===== */
.iforge-password-card {
  max-width: 500px;
  margin: 40px auto;
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
}
.iforge-password-card-header {
  padding: 12px 16px;
  background: var(--panel);
  border-bottom: 3px solid var(--border);
  font-family: var(--font-brush);
  font-size: 1.05rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
  text-align: center;
}
.iforge-password-card-body {
  padding: 16px;
  font-size: 0.85rem;
  color: var(--ink);
}
.iforge-password-note {
  margin-bottom: 12px;
  line-height: 1.5;
}
.iforge-password-card-body form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.iforge-password-input {
  width: 100%;
  padding: 8px 10px;
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 3px 3px 0 var(--border) inset;
  border-radius: var(--radius);
  font-family: var(--font-serif);
  font-size: 0.9rem;
  color: var(--ink);
}
.iforge-password-input:focus { outline: none; border-color: var(--gold); }
.iforge-password-submit {
  display: block;
  margin: 12px auto 0;
  padding: 8px 20px;
  background: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.85rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: background 0.15s, transform 0.15s;
  align-self: center;
}
.iforge-password-submit:hover { background: var(--gold-hover); transform: translateY(-1px); }
.iforge-password-error {
  padding: 8px 14px;
  background: rgba(180,40,40,0.1);
  border-bottom: 2px solid #b42828;
  font-family: var(--font-sans);
  font-size: 0.78rem;
  color: #b42828;
  font-weight: 700;
  text-align: center;
}

/* ===== GOTO UNREAD ===== */
.iforge-gotounread {
  font-size: 0.75rem;
  color: var(--gold);
  font-weight: 700;
  text-decoration: none;
  margin-right: 2px;
  font-family: var(--font-sans);
}
.iforge-gotounread:hover { color: var(--gold-hover); }

/* ===== STICKY SEP ===== */
.iforge-sticky-sep {
  border-top: 2px dashed var(--gold);
  padding: 4px 0;
  display: flex;
  justify-content: center;
}
.iforge-sticky-sep-label {
  font-family: var(--font-brush);
  font-size: 0.72rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
  background: var(--bg);
  padding: 2px 10px;
  border-radius: var(--radius);
  border: 2px solid var(--gold);
}

/* ===== MULTIPAGE ===== */
.iforge-multipage {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  flex-wrap: wrap;
  padding: 4px 0;
  font-family: var(--font-sans);
  font-size: 0.72rem;
}
.iforge-multipage-page, .iforge-multipage-prev, .iforge-multipage-next {
  display: inline-block;
  padding: 4px 10px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  color: #fff;
  font-weight: 700;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  transition: background 0.15s, transform 0.15s, border-color 0.15s;
}
.iforge-multipage-page:hover, .iforge-multipage-prev:hover, .iforge-multipage-next:hover {
  background: var(--gold);
  color: var(--panel);
  transform: translateY(-1px);
  border-color: var(--gold);
}
.iforge-multipage-current {
  display: inline-block;
  padding: 4px 10px;
  background: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  color: var(--panel);
  font-weight: 700;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}
.iforge-multipage-ellipsis {
  background: transparent;
  border: none;
  box-shadow: none;
  color: var(--ink-secondary);
  padding: 4px 4px;
}
.iforge-multipage-pages {
  font-size: 0.68rem;
  color: var(--ink-secondary);
  margin-right: 4px;
}
.iforge-multipage-breadcrumb {
  justify-content: flex-start;
}

.iforge-multipage-jump {
  display: flex;
  align-items: center;
  gap: 4px;
}
.iforge-multipage-jump input[type="number"] {
  width: 42px;
  padding: 3px 4px;
  background: var(--bg-dark);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
}
.iforge-mp-jump-btn {
  padding: 3px 8px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.62rem;
  color: var(--gold);
  text-transform: uppercase;
  cursor: pointer;
}
.iforge-mp-jump-btn:hover { background: var(--gold); color: var(--panel); }
.iforge-mp-jump-link {
  font-size: 0.6rem;
  color: var(--ink-secondary);
  cursor: pointer;
  text-decoration: none;
}
.iforge-mp-jump-link:hover { color: var(--gold); }

/* ===== FORUM JUMP ===== */
.iforge-forumjump {
  display: flex;
  align-items: center;
  gap: 4px;
}
.iforge-forumjump form { display: flex; align-items: center; gap: 4px; }
.iforge-forumjump-label {
  font-family: var(--font-sans);
  font-size: 0.68rem;
  color: var(--ink);
  font-weight: 700;
  text-transform: uppercase;
}
.iforge-forumjump-select {
  padding: 4px 8px;
  background: var(--panel-hover);
  color: #fff;
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  max-width: 220px;
}

/* ===== ERROR NO PERMISSION ===== */
.iforge-error-nopermission-icon {
  font-size: 2.5rem;
  color: var(--gold);
  margin-bottom: 12px;
  display: block;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 700px) {
  .iforge-thread-row { flex-direction: column; align-items: flex-start; }
  .iforge-thread-stats { width: 100%; justify-content: space-between; }
  .iforge-threadlist-toolbar { flex-direction: column; gap: 8px; }
  .iforge-threadlist-toolbar-bottom { flex-direction: column; gap: 8px; }
  .iforge-mod-bar, .iforge-mod-bar form { flex-direction: column; align-items: flex-start; }
  .iforge-sort-bar form { flex-direction: column; align-items: flex-start; }
}
@media (max-width: 900px) {
  .iforge-banner-title { font-size: 2.2rem; }
  #iforge-banner { height: 220px; }
  .iforge-nav-left { gap: 14px; }
  .iforge-nav-link { font-size: 0.72rem; }
}
@media (max-width: 600px) {
  .iforge-banner-title { font-size: 1.8rem; }
  .iforge-nav { padding: 0 10px; }
  .iforge-nav-logo { font-size: 1.1rem; left: 10px; }
  .iforge-nav-right { right: 10px; }
}
