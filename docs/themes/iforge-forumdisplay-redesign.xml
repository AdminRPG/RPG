<template name="multipage_jump_page" version="1839"><![CDATA[<div class="iforge-multipage-jump" style="display: none;">
  <form action="{$jump_url}" method="post">
    <label for="page">{$lang->multipage_jump}:</label> <input type="number" class="textbox" name="page" value="{$page}" size="4" min="1" max="{$pages}" />
    <input type="submit" class="iforge-mp-jump-btn" value="{$lang->go}" />
  </form>
</div>
<a href="javascript:void(0)" class="iforge-mp-jump-link" title="{$lang->multipage_jump}">&#9660;</a>&nbsp;
<script type="text/javascript">
  var go_page = 'go_page_' + $(".iforge-mp-jump-link").length;
  $(".iforge-mp-jump-link").last().attr('id', go_page);
  $(".iforge-multipage-jump").last().attr('id', go_page + '_popup');
  $('#' + go_page).popupMenu(false).on('click', function() {
    var drop = $(this).prev('.iforge-multipage-jump');
    if (drop.is(':visible')) {
      drop.find('.textbox').trigger('focus');
    }
  });
</script>]]></template>

<template name="forumjump_advanced" version="1839"><![CDATA[<div class="iforge-forumjump">
