</form>
</div>
<script type="text/javascript">
$(".iforge-forumjump-select").on('change', function() {
	var option = $(this).val();
	if(option < 0)
	{
		window.location = 'forumdisplay.php?fid='+option;
	}
	else
	{
		window.location = {$forum_link};
	}
});
