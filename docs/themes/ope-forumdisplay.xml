  {$ope_fhead}
  {$subforums}
  {$ope_stories}
  <div class="ope-wrap ope-wrap-forum">{$rules}{$forumjump}</div>
</div>
{$footer}
<script type="text/javascript">
(function(){
  var list=document.querySelector('.ope-slab');
  if(!list) return;
  var threads=list.querySelectorAll('.ope-thread');
  var filts=document.querySelectorAll('.ope-filt');
  var counter=document.querySelector('.ope-toolbar-count b');

  function apply(f){
    var shown=0;
    threads.forEach(function(t){
      var pinned=t.classList.contains('ope-thread-pin');
      var state='abiertos';
      if(t.classList.contains('ope-thread-lock')) state='cerrados';
      if(t.classList.contains('ope-thread-hot')) state='calientes';
      t.style.display=(f==='todos'||pinned||state===f)?'':'none';
      if(t.style.display!=='none') shown++;
    });
    if(counter) counter.textContent=shown;
  }

  filts.forEach(function(b){
    b.addEventListener('click',function(){
      filts.forEach(function(x){x.setAttribute('aria-pressed','false');});
      b.setAttribute('aria-pressed','true');
      apply(b.getAttribute('data-f'));
    });
  });
  apply('todos');
})();
(function(){
  var tabs=document.querySelectorAll('.ope-itab');
  if(!tabs.length) return;
  var panels=document.querySelectorAll('.ope-itabpanel');
  tabs.forEach(function(tab){
    tab.addEventListener('click',function(){
      var key=tab.getAttribute('data-itab');
      tabs.forEach(function(t){t.classList.remove('ope-itab-active');t.setAttribute('aria-pressed','false');});
      panels.forEach(function(p){p.classList.remove('ope-itab-active');});
      tab.classList.add('ope-itab-active');
      tab.setAttribute('aria-pressed','true');
      var panel=document.querySelector('.ope-itabpanel[data-itabpanel="'+key+'"]');
      if(panel) panel.classList.add('ope-itab-active');
    });
  });
})();
</script>
</body>
</html>]]></template>

