<script type="text/javascript">
function opeFlipPostCard(pid) {
  var card = document.getElementById('post-card-' + pid);
  if (!card) return;
  var front = card.querySelector('.ope-postbit-front');
  var back = card.querySelector('.ope-postbit-back');
  if (!front || !back) {
    card.classList.toggle('is-flipped');
    return;
  }
  var toFlip = !card.classList.contains('is-flipped');
  var fromH = card.offsetHeight;
  var toH = toFlip ? back.scrollHeight : front.scrollHeight;
  card.style.height = fromH + 'px';
  void card.offsetHeight;
  card.classList.toggle('is-flipped', toFlip);
  card.style.height = Math.max(1, toH) + 'px';
  var cleared = false;
  var clearH = function () {
    if (cleared) return;
    cleared = true;
    card.style.height = '';
    card.removeEventListener('transitionend', onEnd);
  };
  var onEnd = function (ev) {
    if (ev.target !== card) return;
    if (ev.propertyName !== 'height' && ev.propertyName !== 'transform') return;
    clearH();
  };
  card.addEventListener('transitionend', onEnd);
  window.setTimeout(clearH, 850);
}
</script>
