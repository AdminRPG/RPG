/* ============================================================
   ADDITIONAL CSS FOR SHOWTHREAD & POSTBIT REDESIGN
   (add to iforge.css stylesheet)
   ============================================================ */

/* ----- ATTACHMENTS ----- */
.iforge-attachments {
  margin-top: 14px;
  padding-top: 12px;
  border-top: 2px dashed var(--border);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.iforge-attachment-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  background: var(--bg);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.75rem;
}
.iforge-attachment-icon { flex-shrink: 0; }
.iforge-attachment-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.iforge-attachment-name {
  font-weight: 700;
  color: var(--panel);
  font-size: 0.78rem;
  text-decoration: none;
}
.iforge-attachment-name:hover { color: var(--gold); }
.iforge-attachment-meta {
  font-size: 0.68rem;
  color: var(--ink-secondary);
}
.iforge-attachment-dl {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px; height: 32px;
  background: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  color: var(--panel);
  font-size: 1rem;
  font-weight: 800;
  text-decoration: none;
  flex-shrink: 0;
  transition: background 0.15s;
}
.iforge-attachment-dl:hover { background: var(--gold-hover); color: var(--panel); }
.iforge-attachment-unapproved {
  background: rgba(201,168,76,0.1);
  border-color: var(--gold);
  color: var(--gold);
}

/* Thumbnails */
.iforge-thumbnails-section {
  margin-top: 8px;
}
.iforge-thumbnails-label {
  font-family: var(--font-brush);
  font-size: 0.75rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 6px;
}
.iforge-thumbnails-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.iforge-thumbnail-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 6px;
  background: var(--bg);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  text-decoration: none;
  transition: border-color 0.15s, transform 0.15s;
  width: 100px;
}
.iforge-thumbnail-card:hover {
  border-color: var(--gold);
  transform: translateY(-1px);
}
.iforge-thumbnail-img {
  width: 80px; height: 80px;
  object-fit: cover;
  border: 2px solid var(--border);
  border-radius: var(--radius);
}
.iforge-thumbnail-caption {
  font-family: var(--font-sans);
  font-size: 0.6rem;
  color: var(--ink-secondary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

/* Images */
.iforge-images-section {
  margin-top: 8px;
}
.iforge-images-label {
  font-family: var(--font-brush);
  font-size: 0.75rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 6px;
}
.iforge-images-grid {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.iforge-image-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 8px;
  background: var(--bg);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
}
.iforge-image-img {
  max-width: 100%;
  height: auto;
  border: 2px solid var(--border);
  border-radius: var(--radius);
}
.iforge-image-caption {
  font-family: var(--font-sans);
  font-size: 0.68rem;
  color: var(--ink-secondary);
}

/* ----- POLL ----- */
.iforge-poll {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.iforge-poll-header {
  padding: 10px 14px;
  background: var(--panel);
  border-bottom: 3px solid var(--border);
  font-family: var(--font-brush);
  font-size: 1rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
}
.iforge-poll-options {
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.iforge-poll-option-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: var(--bg);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-serif);
  font-size: 0.88rem;
  color: var(--ink);
  transition: border-color 0.15s;
}
.iforge-poll-option-row:hover { border-color: var(--gold); }
.iforge-poll-radio, .iforge-poll-checkbox {
  accent-color: var(--panel);
  width: 16px; height: 16px;
  flex-shrink: 0;
}
.iforge-poll-option-label {
  flex: 1;
  cursor: pointer;
  font-weight: 600;
}
.iforge-poll-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 14px;
  border-top: 2px dashed var(--border);
}
.iforge-poll-vote-btn {
  padding: 7px 18px;
  background: var(--gold);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.85rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: background 0.15s, transform 0.15s;
}
.iforge-poll-vote-btn:hover {
  background: var(--gold-hover);
  transform: translateY(-1px);
}
.iforge-poll-links {
  font-family: var(--font-sans);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--ink-secondary);
}
.iforge-poll-links a { color: var(--panel); font-weight: 700; }
.iforge-poll-links a:hover { color: var(--gold); }
.iforge-poll-meta {
  padding: 6px 14px;
  border-top: 2px dashed var(--border);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  color: var(--ink-secondary);
  display: flex;
  gap: 16px;
}

/* Poll Results */
.iforge-poll-results {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.iforge-poll-results-header {
  padding: 10px 14px;
  background: var(--panel);
  border-bottom: 3px solid var(--border);
}
.iforge-poll-results-title {
  font-family: var(--font-brush);
  font-size: 1rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
}
.iforge-poll-results-status {
  font-family: var(--font-sans);
  font-size: 0.72rem;
  color: rgba(255,255,255,0.7);
  margin-top: 4px;
}
.iforge-poll-results-options {
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.iforge-poll-result-row {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-sans);
  font-size: 0.78rem;
}
.iforge-poll-result-option {
  flex: 0 0 120px;
  font-weight: 700;
  color: var(--ink);
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.iforge-poll-result-bar-container {
  flex: 1;
  height: 20px;
  background: var(--bg);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border) inset;
  border-radius: var(--radius);
  overflow: hidden;
  position: relative;
}
.iforge-poll-result-bar {
  height: 100%;
  background: var(--panel);
  border-radius: var(--radius) 0 0 var(--radius);
  transition: width 0.4s ease;
}
.iforge-poll-result-bar-voted {
  background: var(--gold);
}
.iforge-poll-result-percent {
  position: absolute;
  right: 6px;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--font-sans);
  font-size: 0.65rem;
  font-weight: 800;
  color: var(--ink);
}
.iforge-poll-result-count {
  flex: 0 0 30px;
  text-align: center;
  font-weight: 700;
  color: var(--panel);
}
.iforge-poll-results-footer {
  padding: 10px 14px;
  border-top: 2px dashed var(--border);
  font-family: var(--font-sans);
  font-size: 0.75rem;
  color: var(--ink);
}
.iforge-poll-results-bottom {
  padding: 6px 14px;
  border-top: 2px dashed var(--border);
  font-family: var(--font-sans);
  font-size: 0.72rem;
  display: flex;
  justify-content: space-between;
  color: var(--ink-secondary);
}
.iforge-poll-results-bottom a { color: var(--panel); font-weight: 700; }
.iforge-poll-results-bottom a:hover { color: var(--gold); }

/* ----- RATING ----- */
.iforge-rating {
  display: flex;
  justify-content: flex-end;
  padding: 4px 0;
}
.iforge-rating-inner {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 12px;
  background: var(--bg-dark);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
}
.iforge-rating-label {
  font-family: var(--font-brush);
  font-size: 0.75rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.iforge-rating-stars {
  display: flex;
  list-style: none;
  gap: 2px;
  margin: 0;
  padding: 0;
  position: relative;
  unicode-bidi: bidi-override;
  color: var(--ink-secondary);
}
.iforge-rating-stars li { display: inline; }
.iforge-rating-current {
  display: block;
  position: absolute;
  top: 0; left: 0;
  overflow: hidden;
  white-space: nowrap;
  color: var(--gold);
  font-size: 1.2rem;
  pointer-events: none;
}
.iforge-rating-star {
  color: var(--ink-secondary);
  font-size: 1.2rem;
  text-decoration: none;
  transition: color 0.15s;
}
.iforge-rating-star:hover,
.iforge-rating-star:hover ~ .iforge-rating-star { color: var(--gold); }

/* ----- SEARCH FORM ----- */
.iforge-search-form {
  display: flex;
  gap: 6px;
  align-items: stretch;
}
.iforge-search-input {
  padding: 8px 12px;
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 3px 3px 0 var(--border) inset;
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.78rem;
  color: var(--ink);
  outline: none;
  flex: 1;
}
.iforge-search-input:focus { border-color: var(--gold); }
.iforge-search-btn {
  padding: 8px 14px;
  background: var(--panel);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.72rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  cursor: pointer;
  transition: background 0.15s;
  white-space: nowrap;
}
.iforge-search-btn:hover { background: var(--panel-hover); }

/* ----- MODERATION OPTIONS ----- */
.iforge-mod-form {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.iforge-mod-label {
  font-family: var(--font-brush);
  font-size: 0.72rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.iforge-mod-select {
  padding: 6px 10px;
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.72rem;
  color: var(--ink);
  font-weight: 600;
  cursor: pointer;
  min-width: 180px;
}
.iforge-mod-select:focus { outline: none; border-color: var(--gold); }
.iforge-mod-form .button {
  padding: 6px 14px;
  background: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: background 0.15s;
}
.iforge-mod-form .button:hover { background: var(--gold-hover); }

/* ----- INLINE MODERATION ----- */
.iforge-inline-mod {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  padding: 8px 12px;
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  margin-bottom: 8px;
}
.iforge-inline-mod-label {
  font-family: var(--font-brush);
  font-size: 0.72rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.iforge-inline-mod-select {
  padding: 6px 10px;
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.72rem;
  color: var(--ink);
  font-weight: 600;
  cursor: pointer;
  min-width: 180px;
}
.iforge-inline-mod-select:focus { outline: none; border-color: var(--gold); }
.iforge-inline-mod-go {
  padding: 6px 14px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: background 0.15s;
}
.iforge-inline-mod-go:hover { background: var(--gold); color: var(--panel); }
.iforge-inline-mod-clear {
  padding: 6px 14px;
  background: transparent;
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  color: var(--ink-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: background 0.15s;
}
.iforge-inline-mod-clear:hover { background: var(--bg); }

/* ----- SIMILAR THREADS ----- */
.iforge-similar {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
}
.iforge-similar-header {
  padding: 10px 14px;
  background: var(--panel);
  border-bottom: 3px solid var(--border);
  font-family: var(--font-brush);
  font-size: 1rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
}
.iforge-similar-list {
  display: flex;
  flex-direction: column;
}
.iforge-similar-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 14px;
  border-bottom: 2px dashed var(--border);
  font-family: var(--font-sans);
  font-size: 0.75rem;
}
.iforge-similar-row:last-child { border-bottom: none; }
.iforge-similar-icon { flex-shrink: 0; }
.iforge-similar-icon img { width: 16px; height: 16px; }
.iforge-similar-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.iforge-similar-title {
  font-weight: 700;
  color: var(--panel);
  text-decoration: none;
}
.iforge-similar-title:hover { color: var(--gold); }
.iforge-similar-meta {
  font-size: 0.68rem;
  color: var(--ink-secondary);
}
.iforge-similar-last {
  flex-shrink: 0;
  text-align: right;
  font-size: 0.68rem;
  color: var(--ink-secondary);
}
.iforge-similar-last a { color: var(--gold); font-weight: 600; }
.iforge-similar-last a:hover { color: var(--gold-hover); }
.iforge-similar-lastdate { display: block; }

/* ----- THREADED BOX ----- */
.iforge-threaded {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
}
.iforge-threaded-header {
  padding: 10px 14px;
  background: var(--panel);
  border-bottom: 3px solid var(--border);
  font-family: var(--font-brush);
  font-size: 0.9rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
}
.iforge-threaded-list {
  padding: 8px 0;
}
.iforge-threaded-bit {
  padding: 6px 14px;
  font-family: var(--font-sans);
  font-size: 0.78rem;
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  border-bottom: 1px dashed var(--border);
}
.iforge-threaded-bit:last-child { border-bottom: none; }
.iforge-threaded-subject {
  color: var(--panel);
  font-weight: 700;
  text-decoration: none;
}
.iforge-threaded-subject:hover { color: var(--gold); }
.iforge-threaded-subject-active {
  color: var(--gold);
  font-weight: 800;
}
.iforge-threaded-bit-active {
  background: rgba(201,168,76,0.08);
  border-left: 3px solid var(--gold);
}
.iforge-threaded-meta {
  color: var(--ink-secondary);
  font-size: 0.7rem;
}

/* ----- THREAD NOTES ----- */
.iforge-thread-notes {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
}
.iforge-thread-notes-header {
  padding: 10px 14px;
  background: var(--panel);
  border-bottom: 3px solid var(--border);
}
.iforge-thread-notes-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-family: var(--font-brush);
  font-size: 0.8rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.iforge-thread-notes-expander {
  width: 16px; height: 16px;
}
.iforge-thread-notes-body {
  padding: 14px;
  font-family: var(--font-serif);
  font-size: 0.85rem;
  color: var(--ink);
  line-height: 1.6;
  white-space: pre-wrap;
}
.iforge-thread-notes-viewall,
.iforge-thread-notes-link {
  font-family: var(--font-sans);
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--panel);
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.iforge-thread-notes-viewall:hover,
.iforge-thread-notes-link:hover { color: var(--gold); }

/* ----- USERS BROWSING ----- */
.iforge-users-browsing {
  max-width: 1200px;
  margin: 8px auto 0;
  padding: 8px 16px;
  font-family: var(--font-sans);
  font-size: 0.72rem;
  color: var(--ink-secondary);
}
.iforge-users-browsing a { color: var(--panel); font-weight: 600; }
.iforge-users-browsing a:hover { color: var(--gold); }
.iforge-browsing-user {
  color: var(--panel);
  font-weight: 600;
  text-decoration: none;
}
.iforge-browsing-user:hover { color: var(--gold); }

/* ----- QUICK REPLY OPTIONS ----- */
.iforge-qr-option {
  display: block;
  font-family: var(--font-sans);
  font-size: 0.72rem;
  color: var(--ink);
  cursor: pointer;
  padding: 2px 0;
}
.iforge-qr-option input[type="checkbox"] {
  accent-color: var(--panel);
}

/* ----- THREAD ACTION LINKS (bottom toolbar) ----- */
.iforge-thread-action-link {
  display: inline-block;
  padding: 5px 12px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  text-decoration: none;
  transition: background 0.15s;
  margin: 0 3px 4px 0;
}
.iforge-thread-action-link:hover {
  background: var(--gold);
  color: var(--panel);
}
.iforge-thread-action-link span { margin-right: 2px; }

/* ----- POSTBIT CLASSIC FALLBACK ----- */
.iforge-postbit_classic {
  display: flex;
  flex-direction: column;
  gap: 0;
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 12px;
}
.iforge-postbit_classic-author {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 12px 14px;
  background: var(--panel);
  border-bottom: 3px solid var(--border);
}
.iforge-postbit_classic-avatar img {
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  width: 48px; height: 48px;
  object-fit: cover;
}
.iforge-postbit_classic-info {
  display: flex;
  flex-direction: column;
  gap: 1px;
}
.iforge-postbit_classic-name {
  font-family: var(--font-brush);
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.iforge-postbit_classic-name a { color: var(--gold); text-decoration: none; }
.iforge-postbit_classic-name a:hover { color: var(--gold-hover); }
.iforge-postbit_classic-badge {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.iforge-postbit_classic-stats {
  font-family: var(--font-sans);
  font-size: 0.67rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.5;
}
.iforge-postbit_classic-body {
  padding: 14px;
  flex: 1;
}
.iforge-postbit_classic-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding-bottom: 8px;
  border-bottom: 2px dashed var(--border);
  margin-bottom: 10px;
  font-family: var(--font-sans);
  font-size: 0.72rem;
  color: var(--ink-secondary);
}
.iforge-postbit_classic-content {
  font-family: var(--font-serif);
  font-size: 0.95rem;
  line-height: 1.65;
  color: var(--ink);
  overflow-wrap: break-word;
  word-break: break-word;
}
.iforge-postbit_classic-signature {
  margin-top: 16px;
  padding-top: 10px;
  border-top: 2px dashed var(--border);
  font-family: var(--font-sans);
  font-size: 0.75rem;
  color: var(--ink-secondary);
  font-style: italic;
}
.iforge-postbit_classic-signature:empty { display: none; }
.iforge-postbit_classic-meta {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  color: var(--ink-secondary);
  margin-top: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.iforge-postbit_classic-actions {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 14px;
  border-top: 2px dashed var(--border);
  flex-wrap: wrap;
}
.iforge-postbit_classic-actions-left,
.iforge-postbit_classic-actions-right {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
}
.iforge-postbit_classic-actions a {
  display: inline-block;
  padding: 4px 10px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.15s;
}
.iforge-postbit_classic-actions a:hover { background: var(--gold); color: var(--panel); }

/* ----- AVATAR ----- */
.iforge-avatar { display: inline-block; }
.iforge-avatar-img {
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  object-fit: cover;
}

/* ----- ONLINE/OFFLINE/AWAY DOTS ----- */
.iforge-status-dot {
  display: inline-block;
  width: 10px; height: 10px;
  border-radius: 50%;
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  vertical-align: middle;
}
.iforge-status-online { background: #2d5a27; }
.iforge-status-offline { background: #999; }
.iforge-status-away { background: var(--gold); }

/* ----- POSTBIT BUTTONS (universal) ----- */
.iforge-btn {
  display: inline-block;
  padding: 4px 10px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.15s, transform 0.15s;
  white-space: nowrap;
}
.iforge-btn:hover {
  background: var(--gold);
  color: var(--panel);
  transform: translateY(-1px);
}
.iforge-btn-small {
  padding: 4px 10px;
  font-size: 0.68rem;
}
.iforge-btn-delete { background: #6b2020; }
.iforge-btn-delete:hover { background: #a03030; }
.iforge-btn-restore { background: var(--panel-hover); }
.iforge-btn-restore:hover { background: var(--gold); color: var(--panel); }
.iforge-btn-multiquote-on {
  background: var(--gold) !important;
  color: var(--panel) !important;
}

/* Edit button dropdown */
.iforge-popup {
  position: absolute;
  z-index: 9999;
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
  min-width: 140px;
}
.iforge-popup-item {
  display: block;
  padding: 6px 12px;
  font-family: var(--font-sans);
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--ink);
  text-decoration: none;
  border-bottom: 2px solid var(--border);
  transition: background 0.15s;
}
.iforge-popup-item:last-child { border-bottom: none; }
.iforge-popup-item:hover { background: var(--gold); color: var(--panel); }

/* ----- USER STARS / GROUP IMAGE ----- */
.iforge-star { display: inline-block; vertical-align: middle; }
.iforge-groupimage { max-width: 80px; height: auto; margin: 2px 0; }

/* ----- STATS / REPUTATION / WARNING ----- */
.iforge-stat {
  display: block;
  font-family: var(--font-sans);
  font-size: 0.67rem;
  color: rgba(255,255,255,0.7);
  text-align: center;
  line-height: 1.4;
}
.iforge-rep-link { text-decoration: none; }
.iforge-rep-link strong { font-weight: 800; }
.reputation_positive { color: #2d5a27; }
.reputation_neutral { color: #999; }
.reputation_negative { color: #c00; }

/* ----- EDITED BY / EDIT REASON ----- */
.iforge-edited {
  font-style: italic;
  font-size: 0.68rem;
  color: var(--ink-secondary);
  font-family: var(--font-sans);
}
.iforge-edited-reason {
  font-style: italic;
  color: var(--panel);
}
.iforge-editreason {
  margin-top: 8px;
  padding: 8px 12px;
  background: var(--bg);
  border: 2px solid var(--border);
  border-radius: var(--radius);
}
.iforge-editreason-label {
  font-family: var(--font-sans);
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--panel);
  margin-right: 6px;
}
.iforge-editreason-input {
  padding: 4px 8px;
  background: var(--bg-dark);
  border: 2px solid var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.7rem;
  color: var(--ink);
  box-shadow: 2px 2px 0 var(--border) inset;
}

/* ----- IP LOGGED ----- */
.iforge-ip {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  color: var(--ink-secondary);
}
.iforge-ip a { color: var(--panel); font-weight: 600; }
.iforge-ip a:hover { color: var(--gold); }

/* ----- POST URL / ICON / STATUS ----- */
.iforge-post-url {
  display: flex;
  align-items: center;
  gap: 4px;
}
.iforge-post-url a {
  color: var(--panel);
  font-weight: 700;
  text-decoration: none;
}
.iforge-post-url a:hover { color: var(--gold); }
.iforge-post-icon {
  vertical-align: middle;
  margin-right: 4px;
}
.iforge-post-status {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  color: var(--gold);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 2px 6px;
  background: var(--panel);
  border: 2px solid var(--border);
  border-radius: var(--radius);
}

/* Inline mod checkbox */
.iforge-inline-checkbox {
  accent-color: var(--gold);
  width: 14px; height: 14px;
  vertical-align: middle;
  margin: 0 0 0 5px;
}

/* Go to post */
.iforge-gotopost {
  display: inline-block;
  width: 0; height: 0;
}

/* ----- DELETED / IGNORED POSTS ----- */
.iforge-deleted-collapsed,
.iforge-ignored {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 20px 14px;
  font-family: var(--font-sans);
  font-size: 0.8rem;
  color: var(--ink-secondary);
  font-style: italic;
  flex: 1;
}
.iforge-deleted-author,
.iforge-ignored-author {
  font-style: normal;
  color: var(--ink);
}
.iforge-deleted-msg,
.iforge-ignored-msg {
  display: flex;
  align-items: center;
  gap: 12px;
}
.iforge-deleted-show,
.iforge-ignored-show {
  flex-shrink: 0;
}
.iforge-deleted-full {
  padding: 14px;
  font-family: var(--font-sans);
  font-size: 0.8rem;
  color: var(--ink-secondary);
}
.iforge-deleted-content {
  font-style: italic;
  margin-top: 6px;
}

/* ----- PROFILE FIELDS ----- */
.iforge-profilefield {
  display: block;
  font-family: var(--font-sans);
  font-size: 0.67rem;
  color: rgba(255,255,255,0.7);
  text-align: center;
  line-height: 1.4;
}
.iforge-profilefield-list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.iforge-profilefield-item {
  font-family: var(--font-sans);
  font-size: 0.67rem;
  color: rgba(255,255,255,0.7);
}

/* ----- CLASSIC HEADER ----- */
.iforge-classic-header {
  display: flex;
  gap: 0;
  background: var(--panel);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 8px;
}
.iforge-classic-header-author {
  flex: 0 0 170px;
  padding: 8px 14px;
  font-family: var(--font-brush);
  font-size: 0.8rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
  border-right: 3px solid var(--border);
}
.iforge-classic-header-msg {
  flex: 1;
  padding: 8px 14px;
  font-family: var(--font-brush);
  font-size: 0.8rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* ----- NEW REPLY CLOSED ----- */
.iforge-newreply-closed {
  display: inline-block;
  padding: 8px 18px;
  background: var(--panel);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 0.9rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
  opacity: 0.7;
}

/* ----- MOD NOTICE ----- */
.iforge-mod-notice {
  padding: 10px 14px;
  background: var(--panel);
  border: 3px solid var(--gold);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--gold);
  margin-bottom: 12px;
  text-align: center;
}

/* ----- ATTACHMENT ICON BADGE ----- */
.iforge-attachment-icon-badge {
  display: inline-block;
  padding: 2px 6px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.65rem;
  font-weight: 800;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* ----- CAPTCHA ----- */
.iforge-captcha {
  display: flex;
  gap: 12px;
  padding: 12px 14px;
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  flex-wrap: wrap;
}
.iforge-captcha-label {
  flex: 0 0 200px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.iforge-captcha-label strong {
  font-family: var(--font-brush);
  font-size: 0.8rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.iforge-captcha-note {
  font-size: 0.68rem;
  color: var(--ink-secondary);
}
.iforge-captcha-subnote {
  display: block;
  font-size: 0.65rem;
  color: red;
  margin-top: 2px;
}
.iforge-captcha-field {
  flex: 1;
  min-width: 0;
}
.iforge-captcha-inner {
  display: flex;
  flex-direction: column;
  gap: 6px;
  align-items: flex-start;
}
.iforge-captcha-img {
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
}
.iforge-captcha-input {
  padding: 6px 10px;
  background: var(--bg-dark);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.78rem;
  color: var(--ink);
  width: 140px;
}
.iforge-captcha-input:focus { outline: none; border-color: var(--gold); }
.iforge-captcha-refresh {
  padding: 4px 10px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.68rem;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.15s;
}
.iforge-captcha-refresh:hover { background: var(--panel-hover); }

.iforge-captcha-nocaptcha,
.iforge-captcha-hcaptcha {
  display: flex;
  gap: 12px;
  padding: 12px 14px;
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  flex-wrap: wrap;
}
.iforge-captcha-invisible {
  display: none;
}

/* ----- RESPONSIVE TWEAKS ----- */
@media (max-width: 650px) {
  .iforge-postbit_classic-author { flex-wrap: wrap; justify-content: center; }
  .iforge-classic-header { flex-direction: column; }
  .iforge-classic-header-author { flex: 0 0 auto; border-right: none; border-bottom: 3px solid var(--border); }
  .iforge-similar-row { flex-direction: column; align-items: flex-start; }
  .iforge-similar-last { text-align: left; }
  .iforge-poll-result-row { flex-wrap: wrap; }
  .iforge-poll-result-option { flex: 0 0 100%; text-align: left; }
  .iforge-captcha { flex-direction: column; }
  .iforge-captcha-label { flex: 0 0 auto; }
  .iforge-mod-form, .iforge-inline-mod { flex-direction: column; align-items: stretch; }
  .iforge-mod-select, .iforge-inline-mod-select { width: 100%; }
}
