<?xml version="1.0" encoding="UTF-8"?>
<theme name="I-Forge RPG" version="1839">
  <templates>
    <template name="newthread" version="1839"><![CDATA[
<html><head>{$headerinclude}</head><body>
<div id="gbe-breadcrumb"><div class="gbe-breadcrumb-in"><a href="{$mybb->settings['bburl']}/index.php">Inicio</a><span class="sep">›</span>{$breadcrumb}</div></div>
{$header}
<div class="gbe-wrap" style="padding-top:16px">
  <div class="gbe-shead"><h1>Nueva historia</h1><span class="gbe-shead-code">// nuevo tema</span><span class="gbe-shead-rule"></span></div>
  {$preview}
  <div class="gbe-plate">
    <div class="gbe-plate-h"><span class="gbe-plate-h-t">{$forum['name']}</span><span class="gbe-plate-h-c">// comienza tu historia</span></div>
    <div class="gbe-plate-b">
      <form action="newthread.php?fid={$fid}&amp;processed=1" method="post" enctype="multipart/form-data">
        <input type="hidden" name="my_post_key" value="{$mybb->post_code}" />
        <input type="hidden" name="action" value="do_newthread" />
        <div style="margin-bottom:12px">
          <label>Prefijo</label><br>
          {$prefixselect}
        </div>
        <div style="margin-bottom:12px">
          <label>Asunto</label><br>
          <input type="text" name="subject" value="{$subject}" style="width:100%" maxlength="85" />
        </div>
        <div class="gbe-meta-fields">
          <div class="gbe-meta-field">
            <label>&Eacute;poca</label>
            <select name="gbe_era" id="gbe_era" class="gbe-meta-sel">
              <option value="presente">Presente &middot; fecha actual (inalterable)</option>
              <option value="pasado">Pasado</option>
            </select>
          </div>
          <div id="gbe-fecha-wrap" style="display:none">
            <div class="gbe-meta-field">
              <label>A&ntilde;o in-rol</label>
              <input type="number" name="gbe_fecha_rol" id="gbe_fecha_rol" class="gbe-meta-sel" min="0" max="9999" step="1" placeholder="p. ej. 1518" />
            </div>
            <div class="gbe-meta-field">
              <label>D&iacute;a</label>
              <input type="number" name="gbe_fecha_dia" class="gbe-meta-sel" min="1" max="65" step="1" placeholder="1&ndash;65" />
            </div>
            <div class="gbe-meta-field">
              <label>Estaci&oacute;n</label>
              <select name="gbe_estacion" class="gbe-meta-sel">
                <option value="">Autom&aacute;tica (por d&iacute;a)</option>
                <option value="Primavera">Primavera</option>
                <option value="Verano">Verano</option>
                <option value="Oto&ntilde;o">Oto&ntilde;o</option>
                <option value="Invierno">Invierno</option>
              </select>
            </div>
          </div>
          <div class="gbe-meta-field">
            <label>Etiqueta</label>
            <select name="gbe_tag" class="gbe-meta-sel">
              <option value="">Sin etiqueta</option>
              <option value="Mision">Misi&oacute;n</option>
              <option value="Trama">Trama</option>
              <option value="Viaje">Viaje</option>
              <option value="Fic">Fic</option>
            </select>
          </div>
        </div>
        <script>
        (function(){
          var e=document.getElementById('gbe_era'),f=document.getElementById('gbe-fecha-wrap');
          if(!e||!f)return;
          var pasadoFields=f.querySelectorAll('input,select');
          function u(){
            var p=(e.value==='pasado');
            f.style.display=p?'flex':'none';
            f.style.flexWrap='wrap';
            f.style.gap='14px';
            pasadoFields.forEach(function(el){el.disabled=!p;});
          }
          e.addEventListener('change',u);u();
        })();
        </script>
        <div style="margin-bottom:12px">
          <label>Mensaje</label><br>
          <div class="gbe-plate gbe-tools">
            <div class="gbe-plate-h"><span class="gbe-plate-h-t">Herramientas</span><span class="gbe-plate-h-c">// editor completo</span></div>
            <div class="gbe-plate-b">
              {$codebuttons}
              <textarea name="message" id="message" rows="20" style="width:100%">{$message}</textarea>
            </div>
          </div>
          {$gbe_tpl_inserter}
        </div>
        {$posticons}
        {$postoptions}
        <div style="margin-top:14px;display:flex;gap:10px">
          <input type="submit" name="submit" class="gbe-btn gbe-btn-hot" value="Publicar historia" />
          <input type="submit" name="previewpost" class="gbe-btn gbe-btn-ghost" value="Previsualizar" />
          <input type="submit" name="savedraft" class="gbe-btn gbe-btn-ghost" value="Guardar borrador" />
        </div>
      </form>
    </div>
  </div>
</div>
{$footer}
</body></html>
]]></template>

