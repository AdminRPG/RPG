<?xml version="1.0" encoding="UTF-8"?>
<theme name="I-Forge RPG" version="1839">
  <templates>
    <template name="newthread" version="1839"><![CDATA[
<html><head>{$headerinclude}</head><body>
<div id="iforge-breadcrumb"><div class="iforge-breadcrumb-in"><a href="{$mybb->settings['bburl']}/index.php">Fragua</a><span class="sep">›</span>{$breadcrumb}</div></div>
{$header}
<div class="iforge-wrap" style="padding-top:16px">
  <div class="iforge-shead"><h1>Forjar colada</h1><span class="iforge-shead-code">// nuevo tema</span><span class="iforge-shead-rule"></span></div>
  {$preview}
  <div class="iforge-plate">
    <div class="iforge-plate-h"><span class="iforge-plate-h-t">{$forum['name']}</span><span class="iforge-plate-h-c">// golpea mientras está caliente</span></div>
    <div class="iforge-plate-b">
      <form action="newthread.php?fid={$fid}&amp;processed=1" method="post" enctype="multipart/form-data">
        <input type="hidden" name="my_post_key" value="{$mybb->post_code}" />
        <div style="margin-bottom:12px">
          <label>Prefijo</label><br>
          {$prefixselect}
        </div>
        <div style="margin-bottom:12px">
          <label>Asunto</label><br>
          <input type="text" name="subject" value="{$subject}" style="width:100%" maxlength="85" />
        </div>
        <div style="margin-bottom:12px">
          <label>Mensaje</label><br>
          {$codebuttons}
          <textarea name="message" id="message" rows="20" style="width:100%">{$message}</textarea>
        </div>
        {$posticons}
        {$postoptions}
        <div style="margin-top:14px;display:flex;gap:10px">
          <input type="submit" class="iforge-btn iforge-btn-hot" value="Publicar colada" />
          <input type="submit" name="previewpost" class="iforge-btn iforge-btn-ghost" value="Previsualizar" />
          <input type="submit" name="savedraft" class="iforge-btn iforge-btn-ghost" value="Guardar borrador" />
        </div>
      </form>
    </div>
  </div>
</div>
{$footer}
</body></html>
]]></template>

    <template name="newreply" version="1839"><![CDATA[
<html><head>{$headerinclude}</head><body>
<div id="iforge-breadcrumb"><div class="iforge-breadcrumb-in"><a href="{$mybb->settings['bburl']}/index.php">Fragua</a><span class="sep">›</span>{$breadcrumb}</div></div>
{$header}
<div class="iforge-wrap" style="padding-top:16px">
  <div class="iforge-shead"><h1>Responder</h1><span class="iforge-shead-code">// nueva respuesta</span><span class="iforge-shead-rule"></span></div>
  {$preview}
  <div class="iforge-plate">
    <div class="iforge-plate-h"><span class="iforge-plate-h-t">{$thread['subject']}</span><span class="iforge-plate-h-c">// golpea mientras está caliente</span></div>
    <div class="iforge-plate-b">
      <form action="newreply.php?tid={$tid}&amp;processed=1" method="post" enctype="multipart/form-data">
        <input type="hidden" name="my_post_key" value="{$mybb->post_code}" />
        <div style="margin-bottom:12px">
          <label>Mensaje</label><br>
          {$codebuttons}
          <textarea name="message" id="message" rows="20" style="width:100%">{$message}</textarea>
          {$multiquote_external}
        </div>
        {$posticons}
        {$postoptions}
        {$modoptions}
        <div style="margin-top:14px;display:flex;gap:10px">
          <input type="submit" class="iforge-btn iforge-btn-hot" value="Publicar respuesta" />
          <input type="submit" name="previewpost" class="iforge-btn iforge-btn-ghost" value="Previsualizar" />
        </div>
      </form>
    </div>
  </div>
  {$threadreview}
</div>
{$footer}
</body></html>
]]></template>

    <template name="editpost" version="1839"><![CDATA[
<html><head>{$headerinclude}</head><body>
<div id="iforge-breadcrumb"><div class="iforge-breadcrumb-in"><a href="{$mybb->settings['bburl']}/index.php">Fragua</a><span class="sep">›</span>{$breadcrumb}</div></div>
{$header}
<div class="iforge-wrap" style="padding-top:16px">
  <div class="iforge-shead"><h1>Editar mensaje</h1><span class="iforge-shead-code">// retocar el metal</span><span class="iforge-shead-rule"></span></div>
  {$preview}
  <div class="iforge-plate">
    <div class="iforge-plate-h"><span class="iforge-plate-h-t">{$thread['subject']}</span></div>
    <div class="iforge-plate-b">
      <form action="editpost.php?pid={$pid}&amp;processed=1" method="post" enctype="multipart/form-data">
        <input type="hidden" name="my_post_key" value="{$mybb->post_code}" />
        <div style="margin-bottom:12px">
          <label>Asunto</label><br>
          <input type="text" name="subject" value="{$subject}" style="width:100%" />
        </div>
        <div style="margin-bottom:12px">
          <label>Mensaje</label><br>
          {$codebuttons}
          <textarea name="message" id="message" rows="20" style="width:100%">{$message}</textarea>
        </div>
        <div style="margin-bottom:12px">
          <label>Razón de edición</label><br>
          <input type="text" name="editreason" value="{$editreason}" style="width:100%" />
        </div>
        {$posticons}
        {$postoptions}
        <div style="margin-top:14px;display:flex;gap:10px">
          <input type="submit" class="iforge-btn iforge-btn-hot" value="Actualizar" />
          <input type="submit" name="previewpost" class="iforge-btn iforge-btn-ghost" value="Previsualizar" />
        </div>
      </form>
    </div>
  </div>
</div>
{$footer}
</body></html>
]]></template>

    <template name="redirect" version="1839"><![CDATA[
<html><head>
<title>{$title}</title>
{$headerinclude}
<meta http-equiv="refresh" content="2;URL={$url}" />
</head><body>
<div class="iforge-wrap" style="padding-top:70px">
  <div class="iforge-plate" style="text-align:center;padding:48px 24px">
    <div style="font-family:var(--disp);font-weight:900;font-size:2rem;text-transform:uppercase;color:var(--paper);margin-bottom:8px">{$title}</div>
    <p style="font-family:var(--mono);font-size:.82rem;color:var(--paper-dim);margin-bottom:16px">{$message}</p>
    <a href="{$url}" class="iforge-btn iforge-btn-hot">Continuar</a>
  </div>
</div>
</body></html>
]]></template>

    <template name="error" version="1839"><![CDATA[
<html><head>
<title>{$title}</title>
{$headerinclude}
</head><body>
<div class="iforge-wrap" style="padding-top:70px">
  <div class="iforge-plate" style="border-color:var(--crack);text-align:center;padding:48px 24px">
    <div style="font-family:var(--disp);font-weight:900;font-size:2rem;text-transform:uppercase;color:var(--crack);margin-bottom:8px">{$title}</div>
    <p style="font-family:var(--mono);font-size:.82rem;color:var(--paper-dim);margin-bottom:16px">{$message}</p>
    {$error}
  </div>
</div>
</body></html>
]]></template>

    <template name="error_nopermission" version="1839"><![CDATA[
<html><head>
<title>{$title}</title>
{$headerinclude}
</head><body>
<div class="iforge-wrap" style="padding-top:70px">
  <div class="iforge-plate" style="border-color:var(--crack);text-align:center;padding:48px 24px">
    <div style="font-family:var(--disp);font-weight:900;font-size:2rem;text-transform:uppercase;color:var(--crack);margin-bottom:8px">{$title}</div>
    <p style="font-family:var(--mono);font-size:.82rem;color:var(--paper-dim);margin-bottom:16px">{$message}</p>
  </div>
</div>
</body></html>
]]></template>

    <template name="multipage" version="1839"><![CDATA[
<div class="iforge-pager">
  {$prevpage}
  {$start}
  {$pages}
  {$nextpage}
</div>
]]></template>

    <template name="multipage_page" version="1839"><![CDATA[
<a href="{$page_url}" class="iforge-page">{$page}</a>
]]></template>

    <template name="multipage_page_current" version="1839"><![CDATA[
<span class="iforge-page on">{$page}</span>
]]></template>

    <template name="multipage_prevpage" version="1839"><![CDATA[
<a href="{$prevpage_url}" class="iforge-page nav" aria-label="Anterior">‹</a>
]]></template>

    <template name="multipage_nextpage" version="1839"><![CDATA[
<a href="{$nextpage_url}" class="iforge-page nav" aria-label="Siguiente">›</a>
]]></template>

    <template name="forumjump_advanced" version="1839"><![CDATA[
<div class="iforge-plate" style="margin-top:14px">
  <div class="iforge-plate-h"><span class="iforge-plate-h-t">Ir a un foro</span></div>
  <div class="iforge-plate-b">
    <form method="get" action="forumdisplay.php" style="display:flex;gap:8px;align-items:center">
      <select name="fid">{$forumjumpbits}</select>
      <input type="submit" class="iforge-btn iforge-btn-sm iforge-btn-hot" value="Ir" />
    </form>
  </div>
</div>
]]></template>

    <template name="forumjump_bit" version="1839"><![CDATA[
<option value="{$forum['fid']}">{$depth}{$forum['name']}</option>
]]></template>

    <template name="postbit_online" version="1839"><![CDATA[
<span style="display:inline-block;width:8px;height:8px;background:var(--patina);border:1px solid #000;margin-right:4px;vertical-align:middle" title="En línea"></span>
]]></template>

    <template name="postbit_offline" version="1839"><![CDATA[
<span style="display:inline-block;width:8px;height:8px;background:var(--ash);border:1px solid #000;margin-right:4px;vertical-align:middle" title="Desconectado"></span>
]]></template>

    <template name="posticons" version="1839"><![CDATA[
<div style="margin-bottom:12px">
  <label>Icono</label><br>
  <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:4px">
    {$iconlist}
  </div>
</div>
]]></template>

    <template name="posticons_icon" version="1839"><![CDATA[
<label style="cursor:pointer;border:2px solid var(--rivet);padding:4px 8px">
  <input type="radio" name="icon" value="{$icon}" /> <img src="{$iconpath}" alt="" style="display:inline;vertical-align:middle" />
</label>
]]></template>

    <template name="codebuttons" version="1839"><![CDATA[
<div class="iforge-plate" style="margin-bottom:0;border-bottom:0">
  <div class="iforge-plate-h"><span class="iforge-plate-h-t">Herramientas</span></div>
  <div class="iforge-plate-b">{$codebuttons}</div>
</div>
]]></template>

  </templates>
</theme>
