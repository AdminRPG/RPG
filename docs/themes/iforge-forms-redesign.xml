=== CSS ===
/* ===== I-Forge RPG - Brutalist Manga Theme ===== */
@import url('https://fonts.googleapis.com/css2?family=Permanent+Marker&display=swap');

:root {
  --bg: #f4f0e6;
  --bg-dark: #ebe6d6;
  --panel: #2d5a27;
  --panel-hover: #3d7a35;
  --gold: #c9a84c;
  --gold-hover: #e2c96b;
  --ink: #1a1a1a;
  --ink-secondary: #5a5a4a;
  --border: #1e3d1a;
  --shadow: 3px 3px 0 #1e3d1a;
  --shadow-hover: 4px 4px 0 #1e3d1a;
  --radius: 3px;
  --font-brush: 'Permanent Marker', 'Comic Sans MS', 'Chalkboard SE', cursive;
  --font-serif: Georgia, 'Palatino Linotype', 'Times New Roman', serif;
  --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
  background: var(--bg) !important;
  color: var(--ink) !important;
  font-family: var(--font-serif) !important;
  font-size: 15px;
  line-height: 1.5;
}

/* ===== POSTING FORMS ===== */
.iforge-form-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  font-family: var(--font-serif);
}
.iforge-form-title {
  font-family: var(--font-brush);
  font-size: 1.6rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  text-shadow: 2px 2px 0 var(--gold);
  margin: 0;
}
.iforge-form-card {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.iforge-form-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.iforge-form-label {
  font-family: var(--font-brush);
  font-size: 0.9rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.iforge-form-subject-row {
  display: flex;
  gap: 8px;
  align-items: center;
}
.iforge-form-input,
.iforge-form-card input[type="text"] {
  padding: 10px 12px;
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 3px 3px 0 var(--border) inset;
  border-radius: var(--radius);
  font-family: var(--font-serif);
  font-size: 0.9rem;
  color: var(--ink);
  width: 100%;
}
.iforge-form-input:focus,
.iforge-form-card input[type="text"]:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 2px rgba(201,168,76,0.3) inset;
}

/* ===== EDITOR ===== */
.iforge-form-editor textarea#message {
  padding: 10px 12px;
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 3px 3px 0 var(--border) inset;
  border-radius: var(--radius);
  font-family: var(--font-serif);
  font-size: 0.9rem;
  color: var(--ink);
  width: 100%;
  max-width: 100%;
  resize: vertical;
}
.iforge-form-editor textarea#message:focus {
  outline: none;
  border-color: var(--gold);
  box-shadow: 0 0 0 2px rgba(201,168,76,0.3) inset;
}

/* ===== CODEBUTTONS / SCEDITOR ===== */
.iforge-codebuttons {
  margin-top: 6px;
}
.iforge-codebuttons .sceditor-container {
  border: 3px solid var(--border) !important;
  border-radius: var(--radius) !important;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.iforge-codebuttons .sceditor-container .sceditor-toolbar {
  background: var(--panel) !important;
  border-bottom: 3px solid var(--border) !important;
  padding: 4px;
}
.iforge-codebuttons .sceditor-container .sceditor-toolbar .sceditor-button {
  background: var(--panel-hover) !important;
  border: 2px solid var(--border) !important;
  box-shadow: 2px 2px 0 rgba(0,0,0,0.2) !important;
  border-radius: var(--radius) !important;
  margin: 2px !important;
}
.iforge-codebuttons .sceditor-container .sceditor-toolbar .sceditor-button:hover,
.iforge-codebuttons .sceditor-container .sceditor-toolbar .sceditor-button.active {
  background: var(--gold) !important;
}
.iforge-codebuttons .sceditor-container textarea,
.iforge-codebuttons .sceditor-container .sceditor-textarea {
  background: var(--bg) !important;
  font-family: var(--font-serif) !important;
  font-size: 0.9rem !important;
  color: var(--ink) !important;
}

/* ===== POST OPTIONS ===== */
.iforge-postoptions-card {
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  padding: 12px 14px;
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  align-items: center;
  font-family: var(--font-sans);
  font-size: 0.78rem;
  color: var(--ink);
}
.iforge-postoptions-label {
  font-family: var(--font-brush);
  font-size: 0.8rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.iforge-postoptions-card label {
  display: flex;
  align-items: center;
  gap: 4px;
  font-weight: 600;
  cursor: pointer;
}
.iforge-postoptions-card input[type="checkbox"] {
  accent-color: var(--gold);
}

/* ===== FORM ACTIONS ===== */
.iforge-form-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.iforge-form-submit {
  padding: 8px 20px;
  background: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 1rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 1px;
  cursor: pointer;
  transition: background 0.15s, transform 0.15s;
}
.iforge-form-submit:hover {
  background: var(--gold-hover);
  transform: translateY(-1px);
}
.iforge-form-submit-secondary {
  padding: 8px 16px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.72rem;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.15s;
}
.iforge-form-submit-secondary:hover {
  background: var(--panel-hover);
}

/* ===== MULTIQUOTE ===== */
.iforge-multiquote {
  margin-top: 8px;
  padding: 8px 12px;
  background: var(--bg);
  border: 2px dashed var(--gold);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.72rem;
  color: var(--ink);
  font-weight: 600;
}
.iforge-multiquote a {
  color: var(--panel);
  font-weight: 700;
}
.iforge-multiquote a:hover {
  color: var(--gold);
}

/* ===== THREAD REVIEW ===== */
.iforge-threadreview {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.iforge-threadreview .iforge-threadreview-title {
  font-family: var(--font-brush);
  font-size: 1rem;
  color: var(--gold);
  text-transform: uppercase;
  margin: 0;
  text-shadow: 2px 2px 0 var(--panel);
}
.iforge-threadreview-posts {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.iforge-threadreview-post {
  padding: 10px 0;
  border-bottom: 2px dashed var(--border);
}
.iforge-threadreview-post:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.iforge-threadreview-post-author {
  font-family: var(--font-sans);
  font-weight: 700;
  font-size: 0.75rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 6px;
}
.iforge-threadreview-post-body {
  font-size: 0.82rem;
  color: var(--ink);
  line-height: 1.5;
}
.iforge-threadreview-more {
  padding-top: 8px;
  font-family: var(--font-sans);
  font-size: 0.75rem;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 1px;
  border-top: 2px dashed var(--border);
}

/* ===== POLL FORM ===== */
.iforge-poll-card {
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-family: var(--font-sans);
  font-size: 0.8rem;
  color: var(--ink);
}
.iforge-poll-desc {
  color: var(--ink-secondary);
  font-size: 0.72rem;
}
.iforge-poll-check {
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 4px;
}
.iforge-poll-options {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.iforge-poll-options-label {
  font-weight: 700;
  color: var(--panel);
  text-transform: uppercase;
  font-size: 0.72rem;
}
.iforge-poll-max {
  color: var(--ink-secondary);
  font-size: 0.7rem;
  font-style: italic;
}
.iforge-poll-input {
  width: 52px;
  padding: 6px 8px;
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.8rem;
  color: var(--ink);
  text-align: center;
  outline: none;
}
.iforge-poll-input:focus {
  border-color: var(--gold);
}

/* ===== POST ICONS ===== */
.iforge-posticons-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}
.iforge-posticon-item {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px 10px;
  background: var(--bg);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  transition: border-color 0.15s, box-shadow 0.15s;
  font-family: var(--font-sans);
  font-size: 0.72rem;
}
.iforge-posticon-item:hover {
  border-color: var(--gold);
}
.iforge-posticon-item input[type="radio"] {
  margin: 0;
  accent-color: var(--gold);
}
.iforge-posticon-item img {
  width: 16px;
  height: 16px;
  object-fit: contain;
}
.iforge-posticon-label {
  color: var(--ink-secondary);
  font-weight: 600;
  font-size: 0.72rem;
}

/* ===== REDIRECT ===== */
.iforge-redirect {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 50vh;
  padding: 32px 16px;
}
.iforge-redirect-inner {
  text-align: center;
  max-width: 520px;
  width: 100%;
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  padding: 40px 32px;
}
.iforge-redirect-icon {
  font-size: 3rem;
  color: var(--panel);
  margin-bottom: 12px;
  text-shadow: 2px 2px 0 var(--gold);
}
.iforge-redirect-title {
  font-family: var(--font-brush);
  font-size: 1.75rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  text-shadow: 2px 2px 0 var(--gold);
  margin: 0 0 12px;
  line-height: 1.2;
}
.iforge-redirect-message {
  font-size: 0.9rem;
  color: var(--ink);
  line-height: 1.5;
  margin-bottom: 20px;
}
.iforge-redirect-link {
  display: inline-block;
  padding: 8px 22px;
  background: var(--gold);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-brush);
  font-size: 1rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 1px;
  text-decoration: none;
  transition: background 0.15s, transform 0.15s;
}
.iforge-redirect-link:hover {
  background: var(--gold-hover);
  transform: translateY(-1px);
  color: var(--panel);
}

/* ===== ERROR PAGES ===== */
.iforge-error-container {
  max-width: 680px;
  margin: 32px auto;
  padding: 0 16px;
}
.iforge-error-card {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  padding: 36px 32px;
  text-align: center;
}
.iforge-error-icon {
  font-size: 3.5rem;
  color: var(--gold);
  margin-bottom: 12px;
  text-shadow: 2px 2px 0 var(--panel);
}
.iforge-error-title {
  font-family: var(--font-brush);
  font-size: 1.6rem;
  color: var(--panel);
  text-transform: uppercase;
  letter-spacing: 1px;
  text-shadow: 2px 2px 0 var(--gold);
  margin: 0 0 16px;
  line-height: 1.2;
}
.iforge-error-body {
  font-size: 0.9rem;
  color: var(--ink);
  line-height: 1.6;
  text-align: left;
}
.iforge-error-body ul,
.iforge-error-body ol {
  padding-left: 20px;
}

/* ===== ERROR INLINE ===== */
.iforge-error-inline {
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  margin: 8px 0;
  overflow: hidden;
}
.iforge-error-inline-banner {
  background: var(--panel);
  color: var(--gold);
  padding: 8px 14px;
  font-family: var(--font-brush);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  border-bottom: 3px solid var(--border);
}
.iforge-error-inline-body {
  padding: 10px 14px;
  font-family: var(--font-sans);
  font-size: 0.78rem;
  color: var(--ink);
  line-height: 1.6;
}
.iforge-error-inline-body ul {
  padding-left: 20px;
  list-style: square;
}
.iforge-error-inline-body ul li {
  margin-bottom: 4px;
}

/* ===== ERROR NOPERMISSION ===== */
.iforge-error-nopermission {
  padding: 20px 24px;
  font-family: var(--font-sans);
  font-size: 0.85rem;
  color: var(--ink);
  line-height: 1.7;
  text-align: left;
}
.iforge-error-nopermission-icon {
  font-size: 2.5rem;
  margin-bottom: 12px;
  display: block;
}
.iforge-error-nopermission ol {
  padding-left: 20px;
  margin: 10px 0;
}
.iforge-error-nopermission ol li {
  margin-bottom: 4px;
}
.iforge-error-nopermission a {
  color: var(--panel);
  font-weight: 700;
}
.iforge-error-nopermission a:hover {
  color: var(--gold);
}
.iforge-error-username {
  margin-top: 12px;
  font-weight: 700;
  color: var(--panel);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.iforge-error-nopermission-loggedout {
  padding: 20px 24px;
  font-family: var(--font-sans);
  font-size: 0.85rem;
  color: var(--ink);
  line-height: 1.7;
  text-align: left;
}
.iforge-error-nopermission-loggedout-icon {
  font-size: 2.5rem;
  margin-bottom: 12px;
  display: block;
}
.iforge-error-nopermission-loggedout ol {
  padding-left: 20px;
  margin: 10px 0;
}
.iforge-error-nopermission-loggedout ol li {
  margin-bottom: 4px;
}
.iforge-error-nopermission-loggedout a {
  color: var(--panel);
  font-weight: 700;
}
.iforge-error-nopermission-loggedout a:hover {
  color: var(--gold);
}

/* ===== GLOBAL FORM INPUTS ===== */
select,
input[type="text"],
input[type="password"],
input[type="email"],
input[type="number"],
textarea {
  padding: 8px 10px;
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.82rem;
  color: var(--ink);
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
}
select:focus,
input[type="text"]:focus,
input[type="password"]:focus,
input[type="email"]:focus,
input[type="number"]:focus,
textarea:focus {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px rgba(201,168,76,0.2);
}
input[type="submit"],
input[type="button"],
button {
  padding: 8px 16px;
  background: var(--panel);
  border: 2px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  font-family: var(--font-sans);
  font-size: 0.78rem;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  cursor: pointer;
  transition: background 0.15s, transform 0.15s;
}
input[type="submit"]:hover,
input[type="button"]:hover,
button:hover {
  background: var(--panel-hover);
  transform: translateY(-1px);
}
input[type="checkbox"] {
  accent-color: var(--gold);
}
input[type="radio"] {
  accent-color: var(--gold);
}

/* ===== RESPONSIVE ===== */
@media (max-width: 600px) {
  .iforge-form-title {
    font-size: 1.3rem;
  }
  .iforge-postoptions-card {
    flex-direction: column;
    align-items: flex-start;
  }
  .iforge-form-actions {
    flex-direction: column;
  }
  .iforge-form-submit,
  .iforge-form-submit-secondary {
    width: 100%;
    text-align: center;
    padding: 10px 16px;
  }
  .iforge-redirect-inner {
    padding: 28px 18px;
  }
  .iforge-redirect-title {
    font-size: 1.3rem;
  }
  .iforge-error-card {
    padding: 24px 18px;
  }
  .iforge-error-title {
    font-size: 1.3rem;
  }
  .iforge-posticons-grid {
    justify-content: center;
  }
}

/* ===== MYBB LEGACY OVERRIDES in form context ===== */
.iforge-form-card .pollbox,
.iforge-form-card form[style] {
  background: var(--bg);
  border: 3px solid var(--border);
  box-shadow: 2px 2px 0 var(--border);
  border-radius: var(--radius);
  padding: 12px 14px;
  font-family: var(--font-sans);
  font-size: 0.8rem;
  color: var(--ink);
}
.iforge-form-card .posticons,
.iforge-form-card tr,
.iforge-form-card td {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}
.iforge-form-card .posticons label {
  cursor: pointer;
}
.iforge-form-card tr,
.iforge-form-card td,
.iforge-form-card .trow1,
.iforge-form-card .trow2,
.iforge-form-card .tcat {
  background: transparent !important;
  border: none !important;
  font-family: var(--font-sans);
  font-size: 0.78rem;
  color: var(--ink);
}
.iforge-form-container .attachbox,
.iforge-form-container .tborder {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  padding: 14px;
}
.iforge-form-container .tborder td,
.iforge-form-container .tborder tr {
  background: transparent !important;
  font-family: var(--font-sans);
  font-size: 0.8rem;
  color: var(--ink);
}
.iforge-form-container .thead,
.iforge-form-container .tcat {
  background: var(--panel) !important;
  color: var(--gold) !important;
  border: 3px solid var(--border) !important;
  box-shadow: var(--shadow) !important;
  font-family: var(--font-brush);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.iforge-form-container .tfoot {
  background: var(--panel) !important;
  color: #fff !important;
  font-family: var(--font-sans);
  font-size: 0.75rem;
  font-weight: 600;
}
.iforge-form-container .forumrules {
  background: var(--bg-dark);
  border: 3px solid var(--border);
  box-shadow: var(--shadow);
  border-radius: var(--radius);
  padding: 14px;
  font-size: 0.85rem;
  color: var(--ink);
}
