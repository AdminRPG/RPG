    <template name="index" version="1839"><![CDATA[<html>
<head>
{$headerinclude}
</head>
<body>
<!-- La navbar (única para todo el sitio) la inyecta el hook pre_output_page
     del plugin ope_rol justo tras <body>. -->

{$header}

<!-- ===== PORTADA: banner (mitad) + tabl&oacute;n (mitad) ===== -->
<div class="ope-top">

  <!-- HERO · banner ilustrado a media pantalla, marco dorado -->
  <header class="ope-hero">
    <div class="ope-hero-bg">
      <img src="{$ope_hero_banner}" alt="" onerror="this.style.display='none'">
    </div>
    <div class="ope-hero-veil" aria-hidden="true"></div>
    <div class="ope-hero-frame" aria-hidden="true"></div>
    <div class="ope-hero-in">
      <h1 class="ope-hero-title">One Piece<br><b>Eternal</b></h1>
    </div>
  </header>

  <!-- TABL&Oacute;N · a la derecha del banner (bento: calendario, lore, feed, curiosidad, staff, discord) -->
  <aside class="ope-tablon">

  <!-- Reloj on-rol: 4 estaciones &times; 65 d&iacute;as -->
  <div class="ope-onrol" style="--season:{$ope_rol_season_color}">
    <span class="ope-onrol-dot" aria-hidden="true"></span>
    <span class="ope-onrol-label">Calendario on-rol</span>
    <span class="ope-onrol-season">{$ope_rol_season}</span>
    <span class="ope-onrol-day">D&iacute;a {$ope_rol_day} <i>/ 65</i></span>
    <span class="ope-onrol-year">A&ntilde;o {$ope_rol_year_label}</span>
    <span class="ope-onrol-bar"><i style="width:{$ope_rol_progress}%"></i></span>
  </div>

  <div class="ope-tablon-grid">

    <!-- Panel destacado: lore -->
    <article class="ope-panel ope-panel-lore" style="grid-area:lore">
      <span class="ope-panel-glow" aria-hidden="true"></span>
      <svg class="ope-panel-mark" viewBox="0 0 200 190" aria-hidden="true">
        <g fill="currentColor"><path d="M100 16 L118 82 L184 95 L118 108 L100 174 L82 108 L16 95 L82 82 Z"/></g>
      </svg>
      <div class="ope-panel-kicker">// el mundo ahora</div>
      <h3 class="ope-panel-title">{$ope_lore_title}</h3>
      <p class="ope-panel-text">{$ope_lore_text}</p>
      <a href="{$mybb->settings['bburl']}/guias.php" class="ope-btn ope-btn-hot ope-btn-sm">Leer m&aacute;s &rarr;</a>
    </article>

    <!-- Feed: &uacute;ltimas historias -->
    <article class="ope-panel ope-panel-feed" style="grid-area:feed">
      <div class="ope-panel-h">
        <span class="ope-live" aria-hidden="true"></span>
        <span class="ope-panel-h-t">&Uacute;ltimas historias</span>
        <a class="ope-panel-h-more" href="{$mybb->settings['bburl']}/search.php?action=getnew">ver todas &rarr;</a>
      </div>
      <div class="ope-feed">{$ope_latest_posts}</div>
    </article>

    <!-- Curiosidad rotativa -->
    <article class="ope-panel ope-panel-curio" style="grid-area:curio">
      <span class="ope-curio-q" aria-hidden="true">&ldquo;</span>
      <div class="ope-panel-kicker">// curiosidad</div>
      <p id="ope-curiosidad-text" class="ope-curio-text">{$ope_curiosidad}</p>
      <span class="ope-curio-bar"><i id="ope-curio-bar"></i></span>
    </article>

    <!-- Staff -->
    <article class="ope-panel ope-panel-staff" style="grid-area:staff">
      <div class="ope-panel-kicker">// el equipo</div>
      <div class="ope-staff-list">{$ope_staff_list}</div>
    </article>

    <!-- Discord (fuera de la zona de staff, pero dentro del tablón) -->
    <article class="ope-panel ope-panel-discord" style="grid-area:discord">
      <a href="{$ope_discord_url}" target="_blank" rel="noopener" class="ope-discord-btn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.07.07 0 0 0-.075.035c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.076-.035A19.736 19.736 0 0 0 3.68 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.073.073 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.128 12.3 12.3 0 0 1-1.873.891.076.076 0 0 0-.04.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.955 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        <span>Únete al Discord</span>
      </a>
    </article>

  </div>
  </aside>

</div>

<!-- ===== ISLAS / CATEGOR&Iacute;AS (regiones + foros) ===== -->
{$forums}

<!-- ===== PIE DE PORTADA: DATOS (censo + presencia + afiliados, panel integrado) ===== -->
<section class="ope-harbor">
  <div class="ope-datos">

    <div class="ope-datos-head">
      <span class="ope-datos-dot" aria-hidden="true"></span>
      <h2 class="ope-datos-title">Datos</h2>
      <span class="ope-datos-rule" aria-hidden="true"></span>
      <span class="ope-datos-tag">// censo del mundo</span>
    </div>

    <!-- Censo del mundo -->
    <div class="ope-census-in">
      <div class="ope-census-c"><div class="ope-census-v">{$stats['numusers']}</div><div class="ope-census-l">Jugadores</div></div>
      <div class="ope-census-c"><div class="ope-census-v">{$stats['numthreads']}</div><div class="ope-census-l">Historias</div></div>
      <div class="ope-census-c"><div class="ope-census-v">{$stats['numposts']}</div><div class="ope-census-l">Mensajes</div></div>
      <div class="ope-census-c"><div class="ope-census-v ope-census-v-name">{$ope_last_char}</div><div class="ope-census-l">&Uacute;ltimo personaje creado</div></div>
    </div>

    <!-- Presencia -->
    <div class="ope-presence">
      <div class="ope-pres-col">
        <div class="ope-pres-h"><span class="ope-pres-t">En l&iacute;nea ahora</span><span class="ope-pres-c">{$ope_online_now_count}</span></div>
        <div class="ope-online">{$ope_online_now}</div>
      </div>
      <div class="ope-pres-col">
        <div class="ope-pres-h"><span class="ope-pres-t">Activos en las &uacute;ltimas 24 h</span><span class="ope-pres-c">{$ope_online_24h_count}</span></div>
        <div class="ope-online">{$ope_online_24h}</div>
      </div>
    </div>

    <!-- Afiliados: hermanos (botones grandes) + afiliados normales (88x31) -->
    <div class="ope-affiliates">
      <div class="ope-affil-block">
        <div class="ope-affil-h"><span class="ope-affil-h-t">Tripulaciones hermanas</span><span class="ope-affil-h-c">// afiliados &eacute;lite</span></div>
        <div class="ope-affil-hermanos">{$ope_hermanos_html}</div>
      </div>
      <div class="ope-affil-block">
        <div class="ope-affil-h"><span class="ope-affil-h-t">Puertos aliados</span><span class="ope-affil-h-c">// afiliados 88&times;31</span></div>
        <div class="ope-affil-grid">{$ope_afiliados_html}</div>
      </div>
    </div>

  </div>
</section>

<script type="text/javascript">
(function(){
  var data = {$curiosidades_json};
  var el = document.getElementById('ope-curiosidad-text');
  var bar = document.getElementById('ope-curio-bar');
  if(!el || !data || data.length < 2) return;
  var i = 0, period = 9000;
  function restartBar(){
    if(!bar) return;
    bar.style.transition = 'none';
    bar.style.width = '0%';
    void bar.offsetWidth;
    bar.style.transition = 'width ' + period + 'ms linear';
    bar.style.width = '100%';
  }
  restartBar();
  setInterval(function(){
    i = (i + 1) % data.length;
    el.style.opacity = 0;
    setTimeout(function(){ el.textContent = data[i]; el.style.opacity = 1; }, 220);
    restartBar();
  }, period);
})();
</script>

{$footer}
</body>
</html>]]></template>

