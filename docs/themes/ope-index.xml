    <div id="ope-news-modal-body" class="ope-news-modal-body"></div>
  </div>
</div>


<script type="text/javascript">
(function(){
  var data = {$ope_noticias_json};
  var el = document.getElementById('ope-curiosidad-text');
  var titleEl = document.getElementById('ope-news-title');
  var bar = document.getElementById('ope-curio-bar');
  var item = document.getElementById('ope-news-item');
  var modal = document.getElementById('ope-news-modal');
  var mTitle = document.getElementById('ope-news-modal-title');
  var mBody = document.getElementById('ope-news-modal-body');
  if(!el || !data || !data.length) return;
  var i = 0, period = 9000;
  function render(){
    var d = data[i] || {};
    if(titleEl){ titleEl.textContent = d.titulo || ''; titleEl.style.display = d.titulo ? '' : 'none'; }
    el.textContent = d.resumen || '';
    if(item){ item.classList.toggle('has-more', !!d.cuerpo); }
  }
  function openModal(){
    var d = data[i]; if(!d || !d.cuerpo || !modal) return;
    mTitle.textContent = d.titulo || '';
    mBody.innerHTML = d.cuerpo;
    modal.hidden = false; document.body.style.overflow = 'hidden';
  }
  function closeModal(){ if(modal){ modal.hidden = true; document.body.style.overflow = ''; } }
  if(item){
    item.addEventListener('click', openModal);
    item.addEventListener('keydown', function(e){ if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); openModal(); } });
  }
  if(modal){
    modal.addEventListener('click', function(e){ if(e.target.getAttribute('data-close')) closeModal(); });
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeModal(); });
  }
  render();
  function restartBar(){
    if(!bar) return;
    bar.style.transition = 'none'; bar.style.width = '0%'; void bar.offsetWidth;
    bar.style.transition = 'width ' + period + 'ms linear'; bar.style.width = '100%';
  }
  if(data.length < 2){ if(bar) bar.style.display = 'none'; return; }
  restartBar();
  setInterval(function(){
    i = (i + 1) % data.length;
    el.style.opacity = 0;
    setTimeout(function(){ render(); el.style.opacity = 1; }, 220);
    restartBar();
  }, period);
})();
</script>

